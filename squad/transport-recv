#!/usr/bin/env bash
# transport-recv — the DESTINATION half of `squad transport`, run on the target
# machine (locally, or piped to `ssh bash -s`).
#
# Everything here is destination-side by necessity: the encoded Claude state
# dir, the derived agent name and the roster row all depend on the DESTINATION's
# absolute paths and hostname, so none of it can be computed correctly by the
# source box. The source ships bytes (repo via git, memory + re-keyed
# transcripts via rsync) and then calls this to wire them up.
#
# Idempotent: every step no-ops if already done, so a half-finished transport
# can simply be re-run.
#
# Args: <dest-dir> <workspace-file> <suffix> <project> <args> <class> <hub-url>
set -euo pipefail

DEST="${1:?dest dir}"; WSFILE="${2:?workspace file}"; SUFFIX="${3:?suffix}"
PROJECT="${4:?org/repo}"; LAUNCH_ARGS="${5:-}"; CLASS="${6:-}"; HUB_URL="${7:-}"
CONF="${SQUAD_CONF:-$HOME/.config/squad/squad.conf}"

command -v python3 >/dev/null || { echo "!! no python3 on this host"; exit 1; }

# 1. identity suffix FIRST — every later step derives the same name from it.
python3 - "$HOME/.mcp-hub/config.json" "$DEST" "$SUFFIX" "$PROJECT" <<'PY'
import json, pathlib, sys
cfg, dest, suffix, project = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4]
cfg.parent.mkdir(parents=True, exist_ok=True)
try:
    data = json.loads(cfg.read_text(encoding="utf-8"))
    assert isinstance(data, dict)
except Exception:
    data = {}
ws = data.get("workspaces")
data["workspaces"] = ws if isinstance(ws, dict) else {}
data["workspaces"][dest] = suffix
projects = data.get("projects")
projects = projects if isinstance(projects, list) else []
if project not in projects:
    projects.append(project)
data["projects"] = projects
cfg.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
print(f"  identity suffix: {suffix}   (project opted in)")
PY

# 2. derived name — ASK the cli, never re-derive. squad deriving from basename
#    while cli.py derives from the git remote is what makes a clone's
#    statusline read `hub ?` forever.
# `ssh host 'cmd'` runs a NON-interactive shell, which never sources the profile
# that puts ~/.local/bin on PATH — so `command -v mcp-hub` fails on a box where
# mcp-hub is plainly installed. Found the moment this ran against a second real
# machine (dev-vm-1, 2026-07-26); a loopback rig cannot expose it, because it
# shares the caller's own PATH. Look where it actually lives before giving up.
find_mcp_hub() {
  local c
  command -v mcp-hub 2>/dev/null && return 0
  for c in "$HOME/.local/bin/mcp-hub" \
           "$DEST/.venv/bin/mcp-hub" \
           "$HOME/Projects/code/monkeypashion/mcp-hub/.venv/bin/mcp-hub"; do
    [ -x "$c" ] && { printf '%s\n' "$c"; return 0; }
  done
  return 1
}
# Prefer the code we JUST CLONED over anything installed here. Two reasons:
# the clone is guaranteed to match the transport that shipped it (an installed
# mcp-hub built from master may predate `identity` entirely — dev-vm-1,
# 2026-07-26), and cli.py imports with a bare python3 because every third-party
# import in it is lazy, so no venv or pip install is needed at the destination.
NAME=""
if [ -f "$DEST/src/mcp_hub/cli.py" ]; then
  NAME="$(python3 - "$DEST" "$DEST/src" <<'PYID' 2>/dev/null || true
import sys
sys.path.insert(0, sys.argv[2])
try:
    from mcp_hub.cli import _derive_agent_identity
except Exception:
    raise SystemExit(0)
name, _project = _derive_agent_identity(sys.argv[1])
if name:
    print(name)
PYID
)"
fi
# Fall back to an installed mcp-hub (older transports, or a dest whose clone
# predates `identity`). Never re-derive by hand: squad deriving from basename
# while cli.py derives from the git remote is what makes a statusline read
# `hub ?` forever.
if [ -z "$NAME" ]; then
  MCPHUB="$(find_mcp_hub || true)"
  [ -n "$MCPHUB" ] && NAME="$("$MCPHUB" identity --cwd "$DEST" --any 2>/dev/null || true)"
fi
if [ -z "$NAME" ]; then
  echo "!! cannot derive the agent name here — mcp-hub not found or not working."
  echo "   Looked on PATH, in ~/.local/bin, in $DEST/.venv/bin, and in the"
  echo "   canonical clone's .venv. Install it on this host (pip install -e in a"
  echo "   clone) or symlink it into ~/.local/bin, then re-run — this script is"
  echo "   idempotent."
  exit 1
fi
echo "  identity: $NAME"

# 2b. COLLISION CHECK — before anything is seeded.
# Deliberately here, not beside the roster append: steps 3-6 write .mcp.json,
# trust/MCP approval and a workspace folder entry, so checking later meant a
# refusal had already changed state for a destination we then declined to
# enrol. Caught in review by mcp-hub-dev-vm-1, who was right that "changes
# nothing" was overstated.
EXISTING="$(awk -F'|' -v n="$NAME" '$1==n{print $2; exit}' "$CONF" 2>/dev/null || true)"
if [ -n "$EXISTING" ] && [ "$EXISTING" != "$DEST" ]; then
  # IDENTITY COLLAPSE, not idempotency. The name already belongs to a DIFFERENT
  # worktree, so appending would be unreachable anyway (field() takes the first
  # match) and skipping silently would hand two clones one identity — sharing a
  # hub binding, inbox, heartbeat pidfile and status cache.
  echo "!! REFUSING: '$NAME' already names a DIFFERENT worktree."
  echo "     existing : $EXISTING"
  echo "     this one : $DEST"
  echo "   Two clones cannot share one identity — they would share a hub"
  echo "   binding, inbox, heartbeat pidfile and status cache."
  echo "   Pass a distinct identity suffix for this destination (squad"
  echo "   transport all does this automatically: <workspace>-2, -3, ...)."
  # Roll back the only thing we wrote (step 1), so a refusal really does leave
  # nothing behind. The cloned repo is the SOURCE's doing and is left in place
  # deliberately — reporting it beats deleting a directory we did not create.
  python3 - "$HOME/.mcp-hub/config.json" "$DEST" <<'PYROLL' || true
import json, pathlib, sys
cfg, dest = pathlib.Path(sys.argv[1]), sys.argv[2]
try:
    data = json.loads(cfg.read_text(encoding="utf-8"))
    ws = data.get("workspaces")
    if isinstance(ws, dict) and dest in ws:
        ws.pop(dest)
        data["workspaces"] = ws
        cfg.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
        print("   (rolled back this destination's identity suffix)")
except Exception:
    pass
PYROLL
  echo "   left in place: the clone at $DEST — remove it if you don't want it."
  exit 5
fi

# 3. hub connection file — untracked, so it never arrives via git.
python3 - "$DEST/.mcp.json" "$HUB_URL" <<'PY'
import json, os, pathlib, sys
url = sys.argv[2] or os.environ.get("MCP_HUB_URL") or "http://100.109.6.114:8090/mcp"
pathlib.Path(sys.argv[1]).write_text(
    json.dumps({"mcpServers": {"hub": {"type": "http", "url": url}}}, indent=2) + "\n",
    encoding="utf-8")
print(f"  .mcp.json generated ({url})")
PY

# 4. trust + MCP pre-approval, or first launch blocks on two dialogs forever
#    and heal can't tell, because the pane looks alive.
python3 - "$HOME/.claude.json" "$DEST" <<'PY'
import json, os, pathlib, sys, tempfile
p, proj = pathlib.Path(sys.argv[1]), sys.argv[2]
# MISSING and UNPARSEABLE need opposite treatment, and conflating them meant a
# machine where Claude Code had never run got no seeding at all — so the
# transported agent still blocked on the trust dialog, which is the entire thing
# this step exists to prevent.
if not p.exists():
    data = {}                                 # fresh box: ours to create
else:
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
        assert isinstance(data, dict)
    except Exception:
        # A real file we cannot parse: never clobber it. Fail open and say so —
        # the operator answers one dialog, rather than losing their settings.
        print("  !! ~/.claude.json unreadable — leaving it alone;")
        print("     the agent will ask about folder trust on first launch")
        raise SystemExit(0)
entry = data.setdefault("projects", {}).setdefault(proj, {})
entry["hasTrustDialogAccepted"] = True
enabled = entry.get("enabledMcpjsonServers")
enabled = enabled if isinstance(enabled, list) else []
if "hub" not in enabled:
    enabled.append("hub")
entry["enabledMcpjsonServers"] = enabled
entry.setdefault("allowedTools", [])
entry.setdefault("disabledMcpjsonServers", [])
fd, tmp = tempfile.mkstemp(dir=str(p.parent), prefix=".claude.json.")
with os.fdopen(fd, "w", encoding="utf-8") as fh:
    json.dump(data, fh, indent=2)
os.replace(tmp, p)                            # this file is live; replace atomically
print("  trust + hub MCP pre-approved")
PY

# 5. roster row — args and class TRAVEL. An agent without them is
#    operationally a different agent: it can't be healed and can't hear.
mkdir -p "$(dirname "$CONF")"
touch "$CONF"
if [ -n "$EXISTING" ]; then
  echo "  roster row already present for $NAME (same worktree — idempotent)"
else
  printf '%s|%s||%s|%s\n' "$NAME" "$DEST" "$LAUNCH_ARGS" "$CLASS" >> "$CONF"
  echo "  roster row added (args: ${LAUNCH_ARGS:-none}, class: ${CLASS:-squad})"
fi

# 6. make it visible in the target workspace. JSONC with comments and
#    hand-formatting, so this is a surgical insert — a load-and-dump would
#    strip the operator's notes and reflow the file.
python3 - "$WSFILE" "$DEST" <<'PY'
import pathlib, re, sys
ws, dest = pathlib.Path(sys.argv[1]), sys.argv[2]
if not ws.is_file():
    print(f"  !! no workspace file at {ws} — add the folder by hand"); raise SystemExit(0)
text = ws.read_text(encoding="utf-8")
if f'"{dest}"' in text:
    print("  workspace already lists this folder"); raise SystemExit(0)
m = re.search(r'"folders"\s*:\s*\[', text)
if not m:
    print('  !! no "folders" array — add the folder by hand'); raise SystemExit(0)
i = m.end()
empty = text[i:].lstrip().startswith("]")
# Match the file's own convention. dev-vm-1's general.code-workspace uses
# RELATIVE paths deliberately — its header says so, "paths are relative, so this
# file moves with the tree unchanged". An absolute path would work and quietly
# break that property, so use relative when the destination sits under the
# workspace file's directory.
shown = dest
try:
    rel = pathlib.Path(dest).relative_to(ws.parent)
    if any('"path": "' + str(f) in text or "'path': '" + str(f) in text
           for f in [p.name for p in [ws.parent]]) or not text.count('"path": "/'):
        shown = str(rel)
except ValueError:
    pass
entry = ('\n    {\n      "name": "%s",\n      "path": "%s"\n    }'
         % (pathlib.Path(dest).name, shown))
ws.write_text(text[:i] + entry + ("" if empty else ",") + text[i:], encoding="utf-8")
print(f"  workspace folder added: {pathlib.Path(dest).name}")
PY

echo "  READY — start it with: squad start $NAME"
