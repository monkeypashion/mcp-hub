{
  "name": "squad-terminals",
  "displayName": "Squad Terminals",
  "description": "Auto-opens one plain terminal per squad agent (squad attach) with icon+color, and adds per-agent squad actions to the terminal tab context menu.",
  "version": "0.6.0",
  "publisher": "monkeypashion",
  "engines": { "vscode": "^1.90.0" },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      { "command": "squad.answerYes", "title": "Answer: Yes", "category": "Squad" },
      { "command": "squad.answerAlways", "title": "Answer: Yes, don't ask again", "category": "Squad" },
      { "command": "squad.answerNo", "title": "Answer: No", "category": "Squad" },
      { "command": "squad.sendPrompt", "title": "Send prompt…", "category": "Squad" },
      { "command": "squad.stockPrompt", "title": "Stock prompt…", "category": "Squad" },
      { "command": "squad.broadcast", "title": "Broadcast to team via agent…", "category": "Squad" },
      { "command": "squad.compact", "title": "/compact", "category": "Squad" },
      { "command": "squad.interrupt", "title": "Interrupt (Esc)", "category": "Squad" },
      { "command": "squad.restartResume", "title": "Restart (resume conversation)", "category": "Squad" },
      { "command": "squad.restartFresh", "title": "Restart (fresh conversation)", "category": "Squad" },
      { "command": "squad.slash.clear", "title": "/clear  (wipe conversation)", "category": "Squad" },
      { "command": "squad.slash.context", "title": "/context", "category": "Squad" },
      { "command": "squad.slash.cost", "title": "/cost", "category": "Squad" },
      { "command": "squad.slash.status", "title": "/status", "category": "Squad" },
      { "command": "squad.slash.doctor", "title": "/doctor", "category": "Squad" },
      { "command": "squad.slash.mcp", "title": "/mcp", "category": "Squad" },
      { "command": "squad.slash.model", "title": "/model", "category": "Squad" },
      { "command": "squad.slash.memory", "title": "/memory", "category": "Squad" },
      { "command": "squad.slash.todos", "title": "/todos", "category": "Squad" },
      { "command": "squad.slash.help", "title": "/help", "category": "Squad" },
      { "command": "squad.slash.custom", "title": "Other /command…", "category": "Squad" }
    ],
    "submenus": [
      { "id": "squad.agentMenu", "label": "Squad" },
      { "id": "squad.slashMenu", "label": "Slash commands" }
    ],
    "menus": {
      "terminal/title/context": [
        { "submenu": "squad.agentMenu", "group": "2_squad" }
      ],
      "terminal/context": [
        { "submenu": "squad.agentMenu", "group": "2_squad" }
      ],
      "squad.agentMenu": [
        { "command": "squad.answerYes", "group": "0_answer@1" },
        { "command": "squad.answerAlways", "group": "0_answer@2" },
        { "command": "squad.answerNo", "group": "0_answer@3" },
        { "command": "squad.sendPrompt", "group": "1_talk@1" },
        { "command": "squad.stockPrompt", "group": "1_talk@2" },
        { "command": "squad.broadcast", "group": "1_talk@3" },
        { "command": "squad.interrupt", "group": "1_talk@4" },
        { "submenu": "squad.slashMenu", "group": "1_talk@5" },
        { "command": "squad.restartResume", "group": "2_lifecycle@1" },
        { "command": "squad.restartFresh", "group": "2_lifecycle@2" }
      ],
      "squad.slashMenu": [
        { "command": "squad.slash.context", "group": "1_info@1" },
        { "command": "squad.slash.cost", "group": "1_info@2" },
        { "command": "squad.slash.status", "group": "1_info@3" },
        { "command": "squad.slash.todos", "group": "1_info@4" },
        { "command": "squad.slash.mcp", "group": "1_info@5" },
        { "command": "squad.slash.doctor", "group": "1_info@6" },
        { "command": "squad.slash.help", "group": "1_info@7" },
        { "command": "squad.compact", "group": "2_change@1" },
        { "command": "squad.slash.model", "group": "2_change@2" },
        { "command": "squad.slash.memory", "group": "2_change@3" },
        { "command": "squad.slash.clear", "group": "3_danger@1" },
        { "command": "squad.slash.custom", "group": "4_custom@1" }
      ]
    }
  }
}
