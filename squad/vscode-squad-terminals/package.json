    "configuration": {
      "title": "Squad Terminals",
      "properties": {
        "squadTerminals.autoStart": {
          "type": "string",
          "enum": [
            "confirm",
            "focus",
            "off"
          ],
          "default": "confirm",
          "enumDescriptions": [
            "Focusing a down agent's terminal shows a one-click 'Start & attach' prompt (default).",
            "Focusing a down agent's terminal starts claude immediately — zero-click; window-restore/panel-reveal focus events can start an agent from a glance.",
            "Never auto-start; use the tab context menu (Squad → Start & attach)."
          ],
          "description": "What happens when you focus the terminal of an agent that is down."
        },
        "squadTerminals.autoAttach": {
          "type": "boolean",
          "default": false,
          "description": "Attach a tab automatically when its agent is started from OUTSIDE this window — over ssh, by a cron, or by the hub's edge realizing a placement. Without it the agent runs but its tab stays a bare shell until you reload or right-click, because the extension only attaches at window-open. Fires once per time the agent comes up, never re-attaching a tab you deliberately detached, and waits ~30s so it cannot land in the middle of the startup-dialog dance."
        },
        "squad.guests": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "markdownDescription": "Claude sessions on machines reachable only by **ssh** — no tmux, no hub identity, no roster row. They appear as tabs in this workspace so a remote box stops needing a separate workflow. Declared in the `.code-workspace` file so they travel with the workspace.",
          "items": {
            "type": "object",
            "required": [
              "host"
            ],
            "properties": {
              "label": {
                "type": "string",
                "description": "Tab label. Defaults to the host."
              },
              "host": {
                "type": "string",
                "description": "ssh host (an ~/.ssh/config alias is fine)."
              },
              "user": {
                "type": "string",
                "description": "ssh user, if not the default."
              },
              "dir": {
                "type": "string",
                "description": "Remote working directory; claude is started there."
              },
              "cmd": {
                "type": "string",
                "markdownDescription": "Override the remote command outright. Needed when the far end is not a POSIX shell — a Windows host logs into PowerShell or cmd, where `cd <dir> && claude` is not portable."
              }
            }
          }
        }
      }
    }
