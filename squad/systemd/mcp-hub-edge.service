[Unit]
# The edge realizer: pull this machine's placements from the hub, act, and
# report what was OBSERVED. Without this running, every placement written from
# any node sits at `pending-edge` forever — the write side is bookkeeping until
# something reconciles it.
#
# A UNIT OF ITS OWN, deliberately not folded into squad-heal.service. heal
# keeps live agents reachable and must not stop doing that because a reconcile
# pass failed; a oneshot that fails takes its whole ExecStart chain with it.
Description=mcp-hub edge — reconcile this machine toward the hub's desired state

[Service]
Type=oneshot
# Seat credentials for `--env-from-host` (e.g. CLAUDE_CODE_OAUTH_TOKEN from
# `claude setup-token`). A systemd user unit sees NO shell environment, so
# without this file the edge can never inject a credential the hub named —
# the seat would die at its door (exit 42) every pass. Optional (-) and
# chmod 600: the file holds VALUES, which is exactly why they never go in
# the unit file itself (unit files are world-readable and end up in git).
EnvironmentFile=-%h/.mcp-hub/edge-env
# Absolute path: systemd user units get a bare PATH with no ~/.local/bin, which
# is the same gap that made `edge apply` die on a raw FileNotFoundError when it
# was first run over ssh.
ExecStart=%h/Projects/code/monkeypashion/mcp-hub/.venv/bin/mcp-hub edge apply
# A reconcile pass that cannot reach the hub is a non-event, not an incident:
# the next tick tries again. Failing loudly here would fill the journal on
# every network blip.
SuccessExitStatus=0 1
