#!/usr/bin/env bash
# load-meter-daily — take today's load-meter reading (v2-fleet F1).
#
# Runs `mcp-hub load-meter` against the LOCAL hub copy named by MCP_HUB_DB and
# writes $MCP_HUB_STATE_DIR/v2-fleet/readings/<UTC day of now>.json. Run by
# squad/systemd/load-meter.timer once a day; safe to run by hand.
#
# What it reads, and nothing else:
#   MCP_HUB_DB                  REQUIRED, no default. A local copy of the hub
#                               database — possibly the body-less projection
#                               (messages(ts, from_agent, to_agent, channel) +
#                               wake_log). Opened read-only and immutable: the
#                               file is never changed and nothing lands beside
#                               it. There is deliberately no fallback to
#                               ~/.mcp-hub/hub.db or the state dir's: a guessed
#                               copy reads a source nobody chose.
#   LOAD_METER_BASELINE_START   REQUIRED, YYYY-MM-DD. A guessed baseline becomes
#   LOAD_METER_BASELINE_END     the "before" that gets quoted.
#   LOAD_METER_NOW              optional ISO-8601 instant (default: now, UTC)
#   LOAD_METER_HUB_DB_TAKEN_AT  optional; when the copy was taken (default: its mtime)
#   LOAD_METER_SNAPSHOT         optional; the wake snapshot
#                               (default $MCP_HUB_STATE_DIR/v2-fleet/wake-snapshot.json)
#   LOAD_METER_TRANSCRIPTS      optional; default ~/.claude/projects
#   LOAD_METER_PYTHON           optional; the python that has mcp_hub
#   $MCP_HUB_STATE_DIR/v2-fleet/changes.json   delivered changes + declared
#                               source stops, when present
#   $MCP_HUB_STATE_DIR/injections.jsonl        the injections ledger
#
# Writes ONLY the reading (atomically: a temp file in readings/, renamed). A
# refusal writes nothing and creates no path.
set -euo pipefail

refuse() { echo "load-meter-daily: $*" >&2; exit 2; }

[ -n "${MCP_HUB_DB:-}" ] \
  || refuse "MCP_HUB_DB is not set: name the local hub copy to read (there is no default)"
[ -f "$MCP_HUB_DB" ] \
  || refuse "MCP_HUB_DB=$MCP_HUB_DB is not a local file"

day_re='^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
[ -n "${LOAD_METER_BASELINE_START:-}" ] \
  || refuse "LOAD_METER_BASELINE_START is not set (YYYY-MM-DD; there is no default)"
[[ "$LOAD_METER_BASELINE_START" =~ $day_re ]] \
  || refuse "LOAD_METER_BASELINE_START=$LOAD_METER_BASELINE_START is not YYYY-MM-DD"
[ -n "${LOAD_METER_BASELINE_END:-}" ] \
  || refuse "LOAD_METER_BASELINE_END is not set (YYYY-MM-DD; there is no default)"
[[ "$LOAD_METER_BASELINE_END" =~ $day_re ]] \
  || refuse "LOAD_METER_BASELINE_END=$LOAD_METER_BASELINE_END is not YYYY-MM-DD"

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
py="${LOAD_METER_PYTHON:-}"
if [ -z "$py" ]; then
  if [ -x "$here/../.venv/bin/python" ]; then py="$here/../.venv/bin/python"
  else py="$(command -v python3 || true)"; fi
fi
[ -n "$py" ] || refuse "no python found: set LOAD_METER_PYTHON"

# Nothing — not even bytecode — is written outside the readings dir.
export PYTHONDONTWRITEBYTECODE=1

now="${LOAD_METER_NOW:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
day="$("$py" -c 'import sys
from mcp_hub.load_meter import parse_instant
print(parse_instant(sys.argv[1]).date().isoformat())' "$now" 2>/dev/null)" \
  || refuse "LOAD_METER_NOW=$now is not an ISO-8601 instant"

state="${MCP_HUB_STATE_DIR:-$HOME/.mcp-hub}"
fleet="$state/v2-fleet"
args=(load-meter
      --hub-db "$MCP_HUB_DB"
      --snapshot "${LOAD_METER_SNAPSHOT:-$fleet/wake-snapshot.json}"
      --transcripts "${LOAD_METER_TRANSCRIPTS:-$HOME/.claude/projects}"
      --injections "$state/injections.jsonl"
      --baseline-start "$LOAD_METER_BASELINE_START"
      --baseline-end "$LOAD_METER_BASELINE_END"
      --now "$now"
      --out "$fleet/readings/$day.json")
[ -n "${LOAD_METER_HUB_DB_TAKEN_AT:-}" ] && args+=(--hub-db-taken-at "$LOAD_METER_HUB_DB_TAKEN_AT")
[ -f "$fleet/changes.json" ] && args+=(--changes "$fleet/changes.json")

exec "$py" -m mcp_hub.cli "${args[@]}"
