# ~/.config/squad/squad.conf — Claude Code squad roster
# Copy this to ~/.config/squad/squad.conf and edit.
#
# Format:  agent_name | worktree | gh_config_dir | claude_args
#   agent_name    hub name — the DERIVED identity: <repo>-<hostname> (squad add fills this in)
#   worktree      path to the project ( ~ is expanded )
#   gh_config_dir GH_CONFIG_DIR for the gh CLI; leave EMPTY if the agent doesn't run `gh`
#                 (git push/pull uses the SSH keys + per-folder identity, no gh needed)
#   claude_args   flags passed to `claude` at launch
#
# The --dangerously-load-development-channels server:hub flag enables live channel-push wake.
# The hub MCP tools (list_agents/send/...) come from ~/.claude.json (user-scope) — already set up.
# Add --continue per agent (via `squad args <agent> "..."`) if you want every (re)launch
# to resume its last thread. NB the flag names differ by layer: --continue is CLAUDE's
# arg (lives here in the roster); `squad restart` takes --resume / --fresh, which add or
# strip --continue for that one restart. `squad restart <a> --continue` is NOT a thing.

mcp-hub-dev|~/SoftwareProjects/monkeypashion/mcp-hub||--dangerously-load-development-channels server:hub

# --- add more agents as the squad grows (uncomment + edit) ---
# agent-name|~/SoftwareProjects/dreamteam-ai-labs/some-repo||--dangerously-load-development-channels server:hub
# agent-name|~/SoftwareProjects/monkeypashion/some-repo||--dangerously-load-development-channels server:hub
