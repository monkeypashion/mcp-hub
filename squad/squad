              if   [ "$s" -lt 60 ]   ; then printf '%ss' "$s"
              elif [ "$s" -lt 3600 ] ; then printf '%dm' $((s/60))
              else printf '%dh%02dm' $((s/3600)) $(((s%3600)/60)); fi; }
            # How long has this agent been blocked on the operator? Nothing
            # records it, so mark the transition: touch on first sight of a
            # dialog, clear when it clears. The file's mtime IS the timestamp.
            wait_since() {
              local a="$1" st="$2" f="$HOME/.mcp-hub/board-wait-$(safe_name "$1")"
              if [ "$st" = "waiting" ]; then
                [ -f "$f" ] || touch "$f" 2>/dev/null
                printf '%s' $(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || date +%s) ))
              else rm -f "$f" 2>/dev/null; printf '0'; fi
            }
            # --- slow tier: unshipped work ------------------------------------
            # Work that exists only in a working tree is invisible to everyone,
            # including the agent that wrote it — the concrete form of the
            # amnesia problem (mcp-hub sat on 4 unpushed commits for a day and
            # nobody could see it). Measured at 0.25s for the whole roster, but
            # that's still 80x the cost of a pane capture, so it runs on its own
            # TTL and the fast loop just reads the cache.
            BOARD_GIT_TTL="${SQUAD_BOARD_GIT_TTL:-15}"
            git_refresh() {
              local c="$HOME/.mcp-hub/board-git.cache" tmp a w d u b
              if [ -f "$c" ] && [ $(( $(date +%s) - $(stat -c %Y "$c" 2>/dev/null || echo 0) )) -lt "$BOARD_GIT_TTL" ]; then
                return 0
              fi
              tmp="$c.$$"; : > "$tmp"
              for a in $(agents); do
                w="$(untilde "$(field "$a" 2)")"
                d=""; u=""; b=""
                if git -C "$w" rev-parse --git-dir >/dev/null 2>&1; then
                  d="$(git -C "$w" status --porcelain 2>/dev/null | grep -c . || true)"
                  u="$(git -C "$w" rev-list --count '@{u}..HEAD' 2>/dev/null || true)"
                  b="$(git -C "$w" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
                fi
                printf '%s\037%s\037%s\037%s\n' "$a" "$d" "$u" "$b" >> "$tmp"
              done
              mv -f "$tmp" "$c" 2>/dev/null || rm -f "$tmp"
            }
            # --- slowest tier: token usage per agent --------------------------
            # Answers "who is burning the budget" while there's still budget to
            # protect. On 2026-07-21 pm took 53% of fleet output on its first
            # day and the only way to find out was to go parsing transcripts
            # after the limit hit 67%. Read from Claude Code's own transcripts,
            # so it costs the agents nothing and cannot be gamed or forgotten.
            # Heaviest scan on the board (62MB today), hence the longest TTL.
            BOARD_USAGE_TTL="${SQUAD_BOARD_USAGE_TTL:-60}"
            usage_refresh() {
              local c="$HOME/.mcp-hub/board-usage.cache" a w
              if [ -f "$c" ] && [ $(( $(date +%s) - $(stat -c %Y "$c" 2>/dev/null || echo 0) )) -lt "$BOARD_USAGE_TTL" ]; then
                return 0
              fi
              { for a in $(agents); do printf '%s\t%s\n' "$a" "$(untilde "$(field "$a" 2)")"; done; } \
                | python3 -c '
import sys, os, json, glob, time, datetime
# agent -> transcript dir: Claude Code encodes the worktree path with / -> -
rows = [l.rstrip("\n").split("\t") for l in sys.stdin if l.strip()]
day = datetime.date.today().isoformat()
hour_ago = time.time() - 3600
out = []
for agent, wt in rows:
    d = os.path.expanduser("~/.claude/projects/" + wt.replace("/", "-"))
    tot = hr = 0
    for f in glob.glob(os.path.join(d, "*.jsonl")):
        try: fh = open(f, errors="ignore")
        except OSError: continue
        with fh:
            for line in fh:
                if "\"usage\"" not in line: continue
                try: rec = json.loads(line)
                except Exception: continue
                ts = rec.get("timestamp") or ""
                if not ts.startswith(day): continue
                u = (rec.get("message") or {}).get("usage") or {}
                o = u.get("output_tokens", 0)
                tot += o
                try:
                    if datetime.datetime.fromisoformat(ts.replace("Z","+00:00")).timestamp() >= hour_ago: hr += o
                except Exception: pass
    out.append((agent, tot, hr))
sys.stdout.write("".join("%s\x1f%d\x1f%d\n" % r for r in out))
' > "$c.$$" 2>/dev/null && mv -f "$c.$$" "$c" 2>/dev/null || rm -f "$c.$$"
            }
            usage_for() {   # -> today<US>last_hour  (output tokens)
              local line; line="$(grep -m1 -F "$1$(printf '\037')" "$HOME/.mcp-hub/board-usage.cache" 2>/dev/null || true)"
              printf '%s' "${line#*$(printf '\037')}"
            }
            human_tok() { local n="${1:-0}"
              if   [ "$n" -ge 1000000 ]; then printf '%d.%dM' $((n/1000000)) $(((n%1000000)/100000))
              elif [ "$n" -ge 1000 ]   ; then printf '%dk' $((n/1000))
              else printf '%d' "$n"; fi; }
            git_for() {   # -> dirty<US>unpushed<US>branch  (empty if not a repo)
              local line; line="$(grep -m1 -F "$1$(printf '\037')" "$HOME/.mcp-hub/board-git.cache" 2>/dev/null || true)"
              printf '%s' "${line#*$(printf '\037')}"
            }
            board_scan() {   # one US-separated row per agent, one capture each
              local a tail st ctx mod g q act el gi
              git_refresh; usage_refresh
              for a in $(agents); do
                if ! tm has-session -t "=$a" 2>/dev/null || ! pane_alive "$a"; then
                  # down faculty is invisible on the board too — same rule as who
                  is_faculty "$a" && continue
                  printf '%s\037%s\037\037\037\0370\037\037\037%s\037%s\n' "$a" "down" "$(git_for "$a")" "$(usage_for "$a")"; continue
                fi
                tail="$(tm capture-pane -p -t "$a" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -20)"
                st="$(classify_text "$tail")"      # shared patterns — never re-implement
                ctx="$(printf '%s\n' "$tail" | grep -oE '[c]tx \[[^]]*\][[:space:]]*[0-9]+%' | tail -1 | grep -oE '[0-9]+%' || true)"
                mod="$(printf '%s\n' "$tail" | grep -oE '[O]pus|[F]able|[S]onnet|[H]aiku' | tail -1 || true)"
                g="$(hub_glyph "$a")"
                q=""
                if [ "$st" = "waiting" ]; then
                  # the ASK itself, plus the action it's asking about (the line
                  # above "Do you want" is the command/summary being approved)
                  q="$(printf '%s\n' "$tail" | grep -B2 -E '[D]o you want' | head -3 \
                       | sed 's/^[[:space:]]*//' | tr '\n' ' ' | cut -c1-110 || true)"
                  [ -n "$q" ] || q="$(printf '%s\n' "$tail" | grep -E 'requires [a]pproval' | tail -1 | sed 's/^[[:space:]]*//')"
                fi
                act="$(printf '%s\n' "$tail" | grep -E '^●' | tail -1 | sed 's/^●[[:space:]]*//' | cut -c1-72 || true)"
                # Elapsed comes from the SPINNER line only ("Nucleating… (~1m 55s
                # · ↓ 6.4k)" — ~ added so this comment can't match classify's
                # working pattern). A bare "(<n><unit>" also matches the statusline's
                # 5h-limit timer — which is how this first read "2h" for a turn
                # seconds old. Anchor on the ellipsis, same shape classify uses.
                el="$(printf '%s\n' "$tail" | grep -E '…[[:space:]]*\([0-9]+[hms]' | tail -1 \
                      | grep -oE '\([0-9]+[hms][^·)]*' | head -1 | tr -d '(' | sed 's/[[:space:]]*$//' || true)"
                printf '%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n' \
                  "$a" "$st" "$g" "$mod" "$ctx" "$(wait_since "$a" "$st")" "${el:-}${el:+ }$act" "$q" "$(git_for "$a")" "$(usage_for "$a")"
              done
            }
            board_json() {
              local first=1; printf '{"generated":"%s","agents":[' "$(date -Is)"
              while IFS=$'\037' read -r a st g mod ctx w act q dirty ahead branch utot uhr; do
                [ -n "$a" ] || continue
                [ "$first" = 1 ] || printf ','; first=0
                printf '{"agent":"%s","state":"%s","hub":"%s","model":"%s","ctx":"%s","waiting_seconds":%s,"action":"%s","question":"%s","dirty":%s,"unpushed":%s,"branch":"%s"}' \
                  "$(jesc "$a")" "$st" "$(jesc "$g")" "$(jesc "$mod")" "$ctx" "${w:-0}" "$(jesc "$act")" "$(jesc "$q")" \
                  "${dirty:-0}" "${ahead:-0}" "$(jesc "${branch:-}")"
              done <<< "$1"
              printf ']}\n'
            }
            board_paint() {
              local rows="$1" n_wait=0 n_work=0 n_idle=0 n_down=0 out=""
              printf '\033[1mSQUAD BOARD\033[0m  %s\n' "$(date +%H:%M:%S)"
              # --- what is blocking the operator: always first, always loudest
              out="$(printf '%s\n' "$rows" | awk -F'\037' '$2=="waiting"')"
              if [ -n "$out" ]; then
                printf '\n\033[1;31m▌NEEDS YOU\033[0m\n'
                while IFS=$'\037' read -r a st g mod ctx w act q dirty ahead branch utot uhr; do
                  [ -n "$a" ] || continue
                  printf '  \033[1;31m🔴 %-26s\033[0m waiting \033[1m%s\033[0m\n' "$a" "$(hms "${w:-0}")"
                  [ -n "$q" ] && printf '     \033[2m%s\033[0m\n' "$q"
                  printf '     \033[36msquad answer %s yes\033[0m  ·  no  ·  always\n' "$a"
                done <<< "$out"
              else
                printf '\n\033[32m▌NOTHING NEEDS YOU\033[0m\n'
              fi
              # --- the parallel picture: everyone running RIGHT NOW
              out="$(printf '%s\n' "$rows" | awk -F'\037' '$2=="working"')"
              printf '\n\033[1m▌WORKING NOW\033[0m\n'
              if [ -n "$out" ]; then
                while IFS=$'\037' read -r a st g mod ctx w act q dirty ahead branch utot uhr; do
                  [ -n "$a" ] || continue
                  printf '  \033[32m🟢 %-26s\033[0m %-2s %-6s %-5s %s\n' "$a" "$g" "${mod:0:6}" "$ctx" "$act"
                done <<< "$out"
              else printf '  \033[2m(none)\033[0m\n'; fi
              # --- idle + down, compact: presence, not detail
              out="$(printf '%s\n' "$rows" | awk -F'\037' '$2=="idle"{printf "%s ",$1}')"
              [ -n "$out" ] && printf '\n\033[2m▌IDLE   %s\033[0m\n' "$out"
              out="$(printf '%s\n' "$rows" | awk -F'\037' '$2=="down"{printf "%s ",$1}')"
              [ -n "$out" ] && printf '\033[1;33m▌DOWN   %s\033[0m\n' "$out"
              # --- work that exists nowhere but a working tree
              out="$(printf '%s\n' "$rows" | awk -F'\037' '($9+0)>0 || ($10+0)>0')"
              if [ -n "$out" ]; then
                printf '\n\033[1;35m▌UNSHIPPED\033[0m\n'
                while IFS=$'\037' read -r a st g mod ctx w act q dirty ahead branch utot uhr; do
                  [ -n "$a" ] || continue
                  printf '  \033[35m%-26s\033[0m %s%s%s \033[2m%s\033[0m\n' "$a" \
                    "$( [ "${dirty:-0}" -gt 0 ] && printf '%s dirty' "$dirty" || printf '' )" \
                    "$( [ "${dirty:-0}" -gt 0 ] && [ "${ahead:-0}" -gt 0 ] && printf ' · ' || printf '' )" \
                    "$( [ "${ahead:-0}" -gt 0 ] && printf '%s unpushed' "$ahead" || printf '' )" \
                    "${branch}"
                done <<< "$out"
              fi
              # --- who is spending the budget (output tokens today / last hour)
              out="$(printf '%s\n' "$rows" | awk -F'\037' '($12+0)>0' | sort -t$'\037' -k12,12nr | head -5)"
              if [ -n "$out" ]; then
                fleet=$(printf '%s\n' "$rows" | awk -F'\037' '{s+=$12} END{print s+0}')
                printf '\n\033[1;36m▌USAGE today\033[0m \033[2m(output tokens · fleet %s)\033[0m\n' "$(human_tok "$fleet")"
                while IFS=$'\037' read -r a st g mod ctx w act q dirty ahead branch utot uhr; do
                  [ -n "$a" ] || continue
                  printf '  \033[36m%-26s\033[0m %-7s %3s%%  \033[2mlast hr %s\033[0m\n' \
                    "$a" "$(human_tok "${utot:-0}")" \
                    "$(( fleet > 0 ? (${utot:-0} * 100 / fleet) : 0 ))" "$(human_tok "${uhr:-0}")"
                done <<< "$out"
              fi
              n_wait=$(printf '%s\n' "$rows" | awk -F'\037' '$2=="waiting"' | grep -c . || true)
              n_work=$(printf '%s\n' "$rows" | awk -F'\037' '$2=="working"' | grep -c . || true)
              n_idle=$(printf '%s\n' "$rows" | awk -F'\037' '$2=="idle"' | grep -c . || true)
              n_down=$(printf '%s\n' "$rows" | awk -F'\037' '$2=="down"' | grep -c . || true)
              printf '\n\033[2m%s blocking · %s running in parallel · %s idle · %s down\033[0m\n' \
                "$n_wait" "$n_work" "$n_idle" "$n_down"
            }
            if [ -n "$bjson" ]; then board_json "$(board_scan)"
            elif [ -n "$bwatch" ]; then
              while true; do
                # top of a pass = quiescent — safe to swap in new code here
                if self_stale; then exec "$SELF" board -w; fi
                rows="$(board_scan)"; printf '\033[2J\033[H'; board_paint "$rows"; sleep 3
              done
            else board_paint "$(board_scan)"; fi ;;
  handoff)  a="$(need_agent "${2:-}")" || exit 1; handoff "$a" ;;
  add)      add_agent "${2:-}" "${3:-}" "${4:-}" ;;
  rm)       a="$(need_agent "${2:-}")" || exit 1; rm_agent "$a" ;;
  pull-local) pull_local "${2:-}" ;;
  *) cat <<EOF
squad — run this machine's squad of Claude Code agents in tmux, wired to the mcp-hub.
(terminology: a "squad" is one machine's agents; the "fleet" is every agent on the hub, all machines.)

enroll (identity is derived: name = <repo>-<hostname>, project = <org>/<repo>)
  $CMD add <org>/<repo>         clone/pull + hub opt-in + enroll (idempotent; migrates legacy names)
  $CMD rm  [agent]              inverse of add: session, roster, hub opt-in, daemon (repo kept)

run
  $CMD up                       start every SQUAD-class agent (idempotent; faculty is skipped)
  $CMD start [agent]            start ONE agent (how on-demand faculty agents come up)
  $CMD stop  [agent]            stop ONE agent (session killed, conversation kept)
  $CMD down                     stop everything (tmux server + keep-alive daemons)
  $CMD restart [agent] [--fresh|--resume]
                                relaunch claude in place (attached viewers keep watching)
                                  no flag:   launch with the agent's roster args as-is
                                  --resume:  add --continue this once (resume last conversation)
                                  --fresh:   drop --continue this once (start a blank conversation)
                                the roster is never modified — use 'args' to change the default
  $CMD comms [on|off] [agent]   hub channel-push wake for ONE agent (no args: report state).
                                comms is a LAUNCH flag, so it applies on next start — never
                                mid-session. Rarely needed by hand: any agent whose repo is in
                                the hub opt-in list is armed automatically at launch. Turn it
                                OFF for an agent you want on the roster but off the hub.
  $CMD attach  [agent] [--no-start]
                                attach, starting/repairing it first if needed; Ctrl-b d detaches
                                --no-start: attach only if already up (cockpit terminals use
                                this so opening a workspace never mass-launches agents)

watch + repair
  $CMD dash [agent...|--pick]   the squad in ONE window — a live tiled pane per agent
                                (starts any that are down). no args: everyone; name agents
                                for an ad-hoc mini-squad; --pick: multi-select list
                                (TAB marks, Enter builds). inside the dash:
                                  type into a pane        talk to that agent
                                  Ctrl-b g                reopen the agent picker (popup)
                                  Ctrl-b z                zoom/unzoom the focused agent
                                  Ctrl-b arrows           move focus  (mouse works too)
                                  Ctrl-b Ctrl-b           pass a Ctrl-b through to the agent
  $CMD answer [agent] yes|always|no
                                answer the approval dialog on an agent's screen — parses the
                                visible options and presses the matching digit (fail-closed:
                                refuses when no matching option is on screen)
  $CMD who [-w]                 who needs YOU: 🔴 waiting on your input · 🟢 working · 💤 idle
                                (reads each agent's screen). -w: refresh every 2s and paint
                                dash tile borders to match — red border = agent is blocked on you
  $CMD ls                       status: tmux liveness + hub presence per agent
  $CMD heal                     fix agents that are up in tmux but broken on the hub:
                                a dead heartbeat daemon (stale status) is respawned quietly;
                                offline/unwakeable agents get nudged to re-register; if still
                                broken on the next pass they auto-restart — but ONLY agents
                                whose roster args include --continue (no conversation lost).
                                a systemd user timer (squad-heal.timer) runs this every 2 min.

interact
  $CMD cmd [agent|all] "..."    type text + Enter into session(s)   e.g. $CMD cmd all "/compact"
  $CMD key [agent] <keys>       raw tmux send-keys (no Enter appended)
  $CMD model [agent] <name>     switch model: default|opus|fable|sonnet|haiku — sends
                                /model <name> and confirms the cache-invalidation prompt
                                for you (via answer's fail-closed parser)
  $CMD args [agent] "..."       set the agent's DEFAULT launch args (roster; used by up/restart/heal)
  $CMD handoff [agent]          commit WIP to wip/<agent>-<date> + push (before switching machines)

helpers
  $CMD pull-local <org>/<repo>  clone/pull into the right account folder, no enrollment

[agent] defaults to the repo you're standing in, so from inside a worktree:
  $CMD attach   /   $CMD restart   /   $CMD cmd "/compact"

roster: $CONF   (agent | worktree | gh_config_dir | claude_args | class)
  class (optional): empty/"squad" = always-on, swept by up/heal, always on who/board.
  "faculty" = on-demand (general-workspace projects): start/stop it yourself,
  visible on who/board only while running. Cockpit terminals appear for both.
  CLASS IS LIFECYCLE ONLY — it does not decide hub membership. Healing and the
  hub glyphs key on COMMS capability (the channels flag in the args field), so a
  comms-enabled faculty agent is healed and shows its real hub state.
hub opt-in list: ~/.mcp-hub/config.json — maintained by add/rm, never edit by hand.
  An opted-in agent is armed with the channels flag automatically at launch; see
  'comms' to override per agent.
EOF
  ;;
esac
