#!/usr/bin/env bash
# squad — tmux orchestrator for a squad of Claude Code agents.
# Lives in mcp-hub/squad/. Runs on the host (where tmux + the agents live).
# Symlink onto PATH:  ln -sf "$PWD/squad/squad" ~/.local/bin/squad
#
# Design:
#   - dedicated tmux socket + session prefix ($PREFIX) so it never collides with other tmux use
#   - send-keys -l (literal) + beat + Enter — delivers slash-commands (/compact), which MCP cannot
#   - health = pane runs a non-shell foreground command, not mere session existence
#   - no eval on config content
set -euo pipefail

CONF="${SQUAD_CONF:-$HOME/.config/squad/squad.conf}"
PREFIX="${SQUAD_PREFIX:-squad}"           # tmux socket + session-name prefix
SLICE="${SQUAD_SLICE:-}"                  # optional systemd user slice for ceilings; empty = none
OPS_DIR="$HOME/SoftwareProjects"
CMD="$(basename "$0")"                    # whatever you symlinked this as (help text only)

tm() { command tmux -L "$PREFIX" "$@"; }  # NB: never a var named TMUX (tmux reserves it)

# ---- config (agent|worktree|gh_config_dir|claude_args ; gh_config_dir may be empty) ----
rows()   { grep -vE '^[[:space:]]*(#|$)' "$CONF" 2>/dev/null || true; }
agents() { rows | cut -d'|' -f1; }
field()  { rows | awk -F'|' -v a="$1" -v n="$2" '$1==a {print $n; exit}'; }
untilde(){ printf '%s\n' "${1/#\~/$HOME}"; }
require_agent() { field "$1" 1 | grep -qx "$1" || { echo "!! unknown agent '$1' (see $CONF)"; exit 1; }; }

ensure_server() {
  tm has-session -t "=$PREFIX-ops" 2>/dev/null && return 0
  if tm list-sessions >/dev/null 2>&1; then
    tm new-session -d -s "$PREFIX-ops" -c "$OPS_DIR"; return 0
  fi
  if [ -n "$SLICE" ] && systemctl --user list-unit-files 2>/dev/null | grep -q "^$SLICE"; then
    systemd-run --user --slice="$SLICE" --scope -q tmux -L "$PREFIX" new-session -d -s "$PREFIX-ops" -c "$OPS_DIR"
  else
    tm new-session -d -s "$PREFIX-ops" -c "$OPS_DIR"
  fi
}

pane_cmd()   { tm display-message -p -t "=$PREFIX-$1" '#{pane_current_command}' 2>/dev/null || true; }
pane_alive() { local c; c="$(pane_cmd "$1")"; [ -n "$c" ] && [ "$c" != bash ] && [ "$c" != sh ] && [ "$c" != zsh ]; }

type_line() { local t="$1"; shift; tm send-keys -t "=$PREFIX-$t" -l "$*"; sleep 0.2; tm send-keys -t "=$PREFIX-$t" Enter; }

up_one() {
  local a="$1" dir ghdir args
  dir="$(untilde "$(field "$a" 2)")"; ghdir="$(untilde "$(field "$a" 3)")"; args="$(field "$a" 4)"
  [ -d "$dir" ] || { echo "!! $a: missing worktree $dir"; return 1; }
  if tm has-session -t "=$PREFIX-$a" 2>/dev/null; then
    if pane_alive "$a"; then echo "$PREFIX-$a already up"
    else echo "!! $PREFIX-$a: session exists but claude is NOT running — try: $CMD restart $a"; fi
    return 0
  fi
  tm new-session -d -s "$PREFIX-$a" -c "$dir"
  [ -n "$ghdir" ] && type_line "$a" "export GH_CONFIG_DIR=\"$ghdir\""
  type_line "$a" "claude $args"
  echo "started $PREFIX-$a  ($args)"
}

org_alias() {
  case "$1" in
    dreamteam-ai-labs) echo "github-dreamteam" ;;
    monkeypashion)     echo "github-monkeypashion" ;;
    byte-hound)        echo "github-byte-hound" ;;
    *) return 1 ;;
  esac
}

pull_local() {
  local spec="$1" org repo alias parent dest
  org="${spec%%/*}"; repo="${spec#*/}"; repo="${repo%.git}"
  [ "$org" != "$spec" ] && [ -n "$repo" ] || { echo "usage: $CMD pull-local <org>/<repo>"; return 1; }
  alias="$(org_alias "$org")" || { echo "!! unknown org '$org'"; return 1; }
  parent="$HOME/SoftwareProjects/$org"; dest="$parent/$repo"; mkdir -p "$parent"
  if [ -d "$dest/.git" ]; then git -C "$dest" pull --ff-only; else git clone "git@$alias:$org/$repo.git" "$dest"; fi
  echo "$dest"
}

handoff() {
  local a="$1" dir cur
  dir="$(untilde "$(field "$a" 2)")"; cur="$(git -C "$dir" branch --show-current)"
  if ! git -C "$dir" diff --quiet || ! git -C "$dir" diff --cached --quiet || [ -n "$(git -C "$dir" ls-files --others --exclude-standard)" ]; then
    local wip="wip/$a-$(date +%Y%m%d-%H%M)"
    git -C "$dir" checkout -b "$wip"; git -C "$dir" add -A; git -C "$dir" commit -m "WIP handoff ($a)"; git -C "$dir" push -u origin "$wip"
    echo "$a: WIP pushed on $wip (from $cur)"
  else
    git -C "$dir" push origin "$cur" 2>/dev/null || true; echo "$a: clean — pushed $cur"
  fi
}

case "${1:-help}" in
  up)       ensure_server; for a in $(agents); do up_one "$a"; done ;;
  restart)  require_agent "$2"; tm kill-session -t "=$PREFIX-$2" 2>/dev/null || true; ensure_server; up_one "$2" ;;
  down)     for a in $(agents); do tm kill-session -t "=$PREFIX-$a" 2>/dev/null || true; done; tm kill-session -t "=$PREFIX-ops" 2>/dev/null || true ;;
  cmd)      t="$2"; shift 2
            if [ "$t" = all ]; then for a in $(agents); do type_line "$a" "$@"; done
            else require_agent "$t"; type_line "$t" "$@"; fi ;;
  key)      t="$2"; shift 2; tm send-keys -t "=$PREFIX-$t" "$@" ;;
  attach)   exec tmux -L "$PREFIX" attach -t "=$PREFIX-$2" ;;
  ls)       for a in $(agents); do
              if tm has-session -t "=$PREFIX-$a" 2>/dev/null; then
                if pane_alive "$a"; then printf '%-30s up        (%s)\n' "$PREFIX-$a" "$(pane_cmd "$a")"
                else printf '%-30s DEGRADED  session up, claude not running\n' "$PREFIX-$a"; fi
              else printf '%-30s down\n' "$PREFIX-$a"; fi
            done
            tm has-session -t "=$PREFIX-ops" 2>/dev/null && printf '%-30s up\n' "$PREFIX-ops" || true ;;
  args)     require_agent "$2"; a="$2"; shift 2
            tmp="$(mktemp)"; awk -F'|' -v a="$a" -v n="$*" 'BEGIN{OFS="|"} $1==a{$4=n} {print}' "$CONF" > "$tmp" && mv "$tmp" "$CONF"
            echo "next launch of $a: $*" ;;
  handoff)  require_agent "$2"; handoff "$2" ;;
  pull-local) pull_local "$2" ;;
  *) cat <<EOF
$CMD up                       start the squad (idempotent) + an ops shell
$CMD down                     stop everything
$CMD restart <agent>          cycle one agent with its current squad.conf entry
$CMD ls                       squad status (DEGRADED = session up but claude dead)
$CMD attach <agent|ops>       attach this terminal (Ctrl-b d detaches; agent keeps running)
$CMD cmd <agent|all> "..."    type text + Enter into session(s)   e.g. $CMD cmd all "/compact"
$CMD key <agent> <keys>       raw tmux send-keys (tmux key names allowed, no Enter appended)
$CMD args <agent> "..."       set next-launch claude args (col 4 of squad.conf)
$CMD handoff <agent>          commit WIP to wip/<agent>-<date> + push (before switching machines)
$CMD pull-local <org>/<repo>  clone/pull into the correct account folder (org derives the alias)

config: $CONF
format: agent | worktree | gh_config_dir (may be empty) | claude_args
EOF
  ;;
esac
