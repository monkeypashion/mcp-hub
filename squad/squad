              exit 1
            fi

            # THE SET TO MOVE. `all` is machine-scoped and was wrong for both of
            # the operator's actual cases (a second squad for a side project; and
            # retiring a box by migrating one workspace) — it would drag in every
            # roster row including unrelated faculty. `workspace <ws>` scopes by
            # FOLDER MEMBERSHIP, the same rule the cockpit uses to decide which
            # tabs to show. That makes squad-vs-general irrelevant: you clone a
            # workspace, whatever it contains.
            if [ -n "$from_ws" ]; then
              from_ws="$(untilde "$from_ws")"
              [ -f "$from_ws" ] || { echo "!! no such workspace file: $from_ws" >&2; exit 1; }
              set -- $(ws_agents "$from_ws")
              [ $# -gt 0 ] || { echo "!! no roster agents live in $(ws_label "$from_ws")"; exit 1; }
              echo "== $(ws_label "$from_ws") -> ${host_arg:+$host_arg:}$(ws_label "$ws_arg") ($# agent(s)) =="
            elif [ "$a_arg" = all ]; then
              set -- $(agents)
              echo "== transport all (this machine) -> ${host_arg:+$host_arg:}$(ws_label "$ws_arg") =="
            else
              a="$(need_agent "$a_arg")" || exit 1
              if [ "$dry" = 1 ]; then
                d="$(untilde "$(field "$a" 2)")"
                if r="$(transport_gate "$d" 2>/dev/null)"; then
                  echo "OK: $a would transport to ${host_arg:+$host_arg:}$(ws_label "$ws_arg")"
                  echo "  branch : $(git -C "$d" branch --show-current) @ $(git -C "$d" rev-parse --short HEAD)"
                  if [ -n "$dest_arg" ]; then
                    echo "  dest   : $dest_arg"
                  elif [ -z "$host_arg" ] && rr="$(resolve_dest "" "" "$HOME" "$(worktree_project "$d")" "$(ws_label "$ws_arg")" 1)"; then
                    echo "  dest   : ${rr%%$'\t'*}"
                    echo "  id-sfx : $(dest_suffix "$(ws_label "$ws_arg")" 1)"
                  else
                    echo "  dest   : $(dest_candidate '~' "$(worktree_project "$d")" "$(ws_label "$ws_arg")" 1) (on $host_arg)"
                  fi
                  [ -f "$(untilde "$ws_arg")" ] || echo "  note   : workspace $(ws_label "$ws_arg") does not exist yet — it will be created"
                else echo "REFUSED: $a — $r"; exit 1; fi
                exit 0
              fi
              transport_agent "$a" "$ws_arg" "$dest_arg" "$host_arg" "$port_arg" "" "$rsh_arg"
              exit $?
            fi

            # Fan-out over the chosen set. Ineligible agents are NAMED with their
            # reason — a "clone the workspace" that quietly drops half of it is
            # worse than a refusal.
            ok=0; skipped=0; claimed=""
            for t in "$@"; do
              d="$(untilde "$(field "$t" 2)")"
              if ! r="$(transport_gate "$d" 2>/dev/null)"; then
                printf '  SKIP  %-38s %s\n' "$t" "$r"; skipped=$((skipped+1)); continue
              fi
              # Two clones of ONE repo collide on both the default destination and
              # the identity suffix; they must be disambiguated TOGETHER or the
              # second silently shares the first's identity.
              # Reserve a slot PER org/repo. Two clones of one repo must get
              # different destinations AND different identity suffixes, and they
              # have to move together — same path with a shared suffix means the
              # second silently inherits the first's agent name. Counting the
              # project (not the resolved path) lets transport_agent do the
              # actual existence probing, which is the only place that knows the
              # destination's $HOME on a remote run.
              lbl="$(ws_label "$ws_arg")"
              pj="$(worktree_project "$d")"; n=1
              for c in $claimed; do [ "$c" = "$pj" ] && n=$((n+1)); done
              claimed="$claimed $pj"
              if [ "$dry" = 1 ]; then
                sfxshow="$(dest_suffix "$lbl" "$n")"
                if [ -z "$host_arg" ] && rr="$(resolve_dest "" "" "$HOME" "$pj" "$lbl" "$n")"; then
                  dshow="${rr%%$'\t'*}"
                else
                  dshow="$(dest_candidate '~' "$pj" "$lbl" "$n")"
                fi
                printf '  OK    %-30s -> %-44s id-suffix %s (%s)\n' \
                  "$t" "$dshow" "$sfxshow" "$(git -C "$d" branch --show-current)"
                ok=$((ok+1)); continue
              fi
              echo "  ---- $t ----"
              if transport_agent "$t" "$ws_arg" "" "$host_arg" "$port_arg" "$n" "$rsh_arg" 2>&1 | sed 's/^/    /'; then
                ok=$((ok+1))
              else
                printf '  FAIL  %-38s transport errored\n' "$t"; skipped=$((skipped+1))
              fi
            done
            echo
            if [ "$dry" = 1 ]; then echo "  $ok eligible, $skipped ineligible (dry run — nothing written)"
            else echo "  $ok transported, $skipped skipped"; fi
            [ "$skipped" = 0 ] || echo "  (ineligible agents need a git remote, a clean tree and nothing unpushed)"
            [ -n "$from_ws" ] && [ "$dry" = 0 ] && [ "$ok" -gt 0 ] && \
              echo "  NOTE: this was a CLONE. The source workspace is untouched — retire it" && \
              echo "        deliberately (verify the destination first, then '$CMD rm <agent>')."
            exit 0 ;;
  ws-new)   # squad ws-new <file.code-workspace> — create an empty target workspace
            shift
            [ -n "${1:-}" ] || { echo "usage: $CMD ws-new <file.code-workspace>" >&2; exit 1; }
            f="$(ws_create "$1")" || exit 1
            echo "$f"
            exit 0 ;;
  teardown) # squad teardown workspace <ws> [--delete-worktrees] [--remove-workspace]
            #                               [--dry-run] [--yes]
            # Closes a cloned squad down. Worktree deletion is gated on the agent
            # having a transport-registered identity suffix, so this can never
            # delete an original — see teardown_workspace.
            shift; ws_arg=""; del=0; dry=0; rmws=0; yes=0
            while [ $# -gt 0 ]; do case "$1" in
              workspace)          ws_arg="${2:-}"; shift 2 ;;
              --delete-worktrees) del=1; shift ;;
              --remove-workspace) rmws=1; shift ;;
              --dry-run)          dry=1; shift ;;
              --yes)              yes=1; shift ;;
              -*) echo "!! unknown teardown flag '$1' (valid: --delete-worktrees, --remove-workspace, --dry-run, --yes)" >&2; exit 1 ;;
              *)  ws_arg="$1"; shift ;;
            esac; done
            [ -n "$ws_arg" ] || {
              echo "usage: $CMD teardown workspace <file.code-workspace> [--delete-worktrees] [--remove-workspace] [--dry-run] [--yes]" >&2; exit 1; }
            # Anything that removes bytes needs a second, explicit act. The dry
            # run is the check; --yes is the acknowledgement that it was read.
            if [ "$dry" = 0 ] && { [ "$del" = 1 ] || [ "$rmws" = 1 ]; } && [ "$yes" = 0 ]; then
              teardown_workspace "$ws_arg" "$del" 1 "$rmws" || exit $?
              echo
              echo "!! refusing to delete without --yes. Re-run with --yes to proceed." >&2
              exit 1
            fi
            teardown_workspace "$ws_arg" "$del" "$dry" "$rmws"
            exit $? ;;
  ws-remove) # squad ws-remove [agent] --from <file.code-workspace>
             # Removes the agent's FOLDER from that workspace only. The agent
             # stays enrolled and still appears in any other workspace listing
             # it. Deliberately NOT the same verb as `rm`, which retires the
             # agent everywhere — two different consequences must not share a
             # name (2026-07-26: the whole Start-label lesson).
            shift; ws_arg=""; a_arg=""
            while [ $# -gt 0 ]; do case "$1" in
              --from) ws_arg="${2:-}"; shift 2 ;;
              -*) echo "!! unknown ws-remove flag '$1' (valid: --from)" >&2; exit 1 ;;
              *)  a_arg="$1"; shift ;;
            esac; done
            [ -n "$ws_arg" ] || { echo "usage: $CMD ws-remove [agent] --from <file.code-workspace>" >&2; exit 1; }
            ws_arg="$(untilde "$ws_arg")"
            [ -f "$ws_arg" ] || { echo "!! no such workspace file: $ws_arg" >&2; exit 1; }
            a="$(need_agent "$a_arg")" || exit 1
            ws_del_folder "$ws_arg" "$(untilde "$(field "$a" 2)")"
            echo "  '$a' is still enrolled (roster, hub opt-in and worktree untouched)."
            echo "  To retire it everywhere instead: $CMD rm $a" ;;
  add-folder) # squad add-folder <dir> [--to <file.code-workspace>]
            shift; d_arg="${1:-}"; ws_arg=""
            while [ $# -gt 0 ]; do case "$1" in
              --to) ws_arg="${2:-}"; shift 2 ;;
              -*)   echo "!! unknown add-folder flag '$1' (valid: --to)" >&2; exit 1 ;;
              *)    shift ;;
            esac; done
            add_folder "$d_arg" "$(untilde "$ws_arg")" ;;
  ext-align) ext_align ;;
  add)      # squad add <org>/<repo> [--to <file.code-workspace>]
            # Clone from GitHub into the RIGHT account folder (org_alias picks the
            # ssh alias, i.e. which GitHub identity; pull_local picks the path),
            # opt in, enrol — and optionally list it in a workspace so a tab
            # appears. No local clone needed beforehand: that is the point.
            shift; spec="${1:-}"; ws_arg=""
            while [ $# -gt 0 ]; do case "$1" in
              --to) ws_arg="${2:-}"; shift 2 ;;
              -*)   echo "!! unknown add flag '$1' (valid: --to)" >&2; exit 1 ;;
              *)    shift ;;
            esac; done
            add_agent "$spec" || exit 1
            if [ -n "$ws_arg" ]; then
              ws_arg="$(untilde "$ws_arg")"
              org="${spec%%/*}"; repo="${spec#*/}"; repo="${repo%.git}"
              ws_add_folder "$ws_arg" "$HOME/Projects/code/$org/$repo" "$repo"
            fi ;;
  rm)       a="$(need_agent "${2:-}")" || exit 1; rm_agent "$a" ;;
  pull-local) pull_local "${2:-}" ;;
  *) cat <<EOF
squad — run this machine's squad of Claude Code agents in tmux, wired to the mcp-hub.
(terminology: a "squad" is one machine's agents; the "fleet" is every agent on the hub, all machines.)

enroll (identity is derived: name = <repo>-<hostname>, project = <org>/<repo>)
  $CMD add <org>/<repo>         clone/pull + hub opt-in + enroll (idempotent; migrates legacy names)
  $CMD rm  [agent]              inverse of add: session, roster, hub opt-in, daemon (repo kept)

run
  $CMD up                       start every SQUAD-class agent (idempotent; faculty is skipped)
  $CMD start [agent]            start ONE agent (how on-demand faculty agents come up)
  $CMD stop  [agent]            stop ONE agent (session killed, conversation kept)
  $CMD down                     stop everything (tmux server + keep-alive daemons)
  $CMD restart [agent] [--fresh|--resume]
                                relaunch claude in place (attached viewers keep watching)
                                  no flag:   launch with the agent's roster args as-is
                                  --resume:  add --continue this once (resume last conversation)
                                  --fresh:   drop --continue this once (start a blank conversation)
                                the roster is never modified — use 'args' to change the default
  $CMD comms [on|off] [agent]   hub channel-push wake for ONE agent (no args: report state).
                                comms is a LAUNCH flag, so it applies on next start — never
                                mid-session. Rarely needed by hand: any agent whose repo is in
                                the hub opt-in list is armed automatically at launch. Turn it
                                OFF for an agent you want on the roster but off the hub.
  $CMD resume [on|off] [agent]  whether a relaunch KEEPS the conversation (--continue in the
                                roster). Also read by heal: it REFUSES to auto-restart a deaf
                                agent whose roster lacks it, rather than destroy the
                                conversation — so comms-on + resume-off means heal can detect
                                the fault and still not fix it. Both are in the cockpit's
                                right-click menu under "Launch settings".
  $CMD attach  [agent] [--no-start]
                                attach, starting/repairing it first if needed; Ctrl-b d detaches
                                --no-start: attach only if already up (cockpit terminals use
                                this so opening a workspace never mass-launches agents)

watch + repair
  $CMD dash [agent...|--pick]   the squad in ONE window — a live tiled pane per agent
                                (starts any that are down). no args: everyone; name agents
                                for an ad-hoc mini-squad; --pick: multi-select list
                                (TAB marks, Enter builds). inside the dash:
                                  type into a pane        talk to that agent
                                  Ctrl-b g                reopen the agent picker (popup)
                                  Ctrl-b z                zoom/unzoom the focused agent
                                  Ctrl-b arrows           move focus  (mouse works too)
                                  Ctrl-b Ctrl-b           pass a Ctrl-b through to the agent
  $CMD answer [agent] yes|always|no
                                answer the approval dialog on an agent's screen — parses the
                                visible options and presses the matching digit (fail-closed:
                                refuses when no matching option is on screen)
  $CMD who [-w]                 who needs YOU: 🔴 waiting on your input · 🟢 working · 💤 idle
                                (reads each agent's screen). -w: refresh every 2s and paint
                                dash tile borders to match — red border = agent is blocked on you
  $CMD ls                       status: tmux liveness + hub presence per agent
  $CMD heal                     fix agents that are up in tmux but broken on the hub:
                                a dead heartbeat daemon (stale status) is respawned quietly;
                                offline/unwakeable agents get nudged to re-register; if still
                                broken on the next pass they auto-restart — but ONLY agents
                                whose roster args include --continue (no conversation lost).
                                a systemd user timer (squad-heal.timer) runs this every 2 min.

interact
  $CMD cmd [agent|all] "..."    type text + Enter into session(s)   e.g. $CMD cmd all "/compact"
  $CMD key [agent] <keys>       raw tmux send-keys (no Enter appended)
  $CMD model [agent] <name>     switch model: default|opus|fable|sonnet|haiku — sends
                                /model <name> and confirms the cache-invalidation prompt
                                for you (via answer's fail-closed parser)
  $CMD args [agent] "..."       set the agent's DEFAULT launch args (roster; used by up/restart/heal)
  $CMD handoff [agent]          commit WIP to wip/<agent>-<date> + push (before switching machines)

workspaces (a "workspace" is a .code-workspace file; the cockpit shows a tab per folder in it)
  $CMD add-folder <dir> [--to <ws>]
                                enrol an EXISTING folder as an agent. git optional — where a
                                remote exists identity is derived and comms come free.
  $CMD ws-new <ws>              create an empty target workspace (transport creates it too)
  $CMD ws-remove [agent] --from <ws>
                                drop the agent's FOLDER from that workspace. Stays enrolled.
  $CMD transport <agent|all|workspace <ws>> --to <ws>
                                clone a whole agent — code, memory, history, launch args and
                                its own hub identity — into another workspace. Lands STOPPED.
                                  --host <h>   another machine (over the tailnet)
                                  --dest <dir> override the destination (single agent only)
                                  --dry-run    report the gate verdict, write nothing
                                Refuses unless the source is reconstructible FROM THE REMOTE:
                                git repo with an origin, nothing uncommitted, unpushed or
                                untracked. Destinations derive from the account ruleset —
                                ~/Projects/code/<org>/<repo>, then <repo>-<label> if taken.
  $CMD teardown workspace <ws> [--delete-worktrees] [--remove-workspace] [--dry-run] [--yes]
                                close a cloned squad down: sessions, roster rows, workspace
                                folder entries, daemons. Code is KEPT unless you ask.
                                --delete-worktrees only ever removes TRANSPORTED CLONES — an
                                agent with no transport-registered identity suffix is
                                unenrolled and left on disk, so this cannot delete an
                                original. Clones with unpushed work are kept too, and named.
                                Anything destructive needs --yes; without it you get the dry
                                run and a refusal.
  $CMD ext-align                name the cockpit extension's install dir after its manifest
                                (VSCode caches on the FOLDER NAME — a stale name means new
                                menu items silently never appear). Reload Window after.

helpers
  $CMD pull-local <org>/<repo>  clone/pull into the right account folder, no enrollment

[agent] defaults to the repo you're standing in, so from inside a worktree:
  $CMD attach   /   $CMD restart   /   $CMD cmd "/compact"

roster: $CONF   (agent | worktree | gh_config_dir | claude_args | class)
  class (optional): empty/"squad" = always-on, swept by up/heal, always on who/board.
  "faculty" = on-demand (general-workspace projects): start/stop it yourself,
  visible on who/board only while running. Cockpit terminals appear for both.
  CLASS IS LIFECYCLE ONLY — it does not decide hub membership. Healing and the
  hub glyphs key on COMMS capability (the channels flag in the args field), so a
  comms-enabled faculty agent is healed and shows its real hub state.
hub opt-in list: ~/.mcp-hub/config.json — maintained by add/rm, never edit by hand.
  An opted-in agent is armed with the channels flag automatically at launch; see
  'comms' to override per agent.
EOF
  ;;
esac
