#!/usr/bin/env bash
# squad — tmux orchestrator for a squad of Claude Code agents.
# Lives in mcp-hub/squad/. Runs on the host (where tmux + the agents live).
# Symlink onto PATH:  ln -sf "$PWD/squad/squad" ~/.local/bin/squad
#
# Design:
#   - dedicated tmux socket ($SOCK) so squad sessions never collide with other tmux use;
#     session names ARE the agent names (no prefix). The ops shell session is "ops"
#     (so don't name an agent "ops").
#   - send-keys -l (literal) + beat + Enter — delivers slash-commands (/compact), which MCP cannot
#   - attach starts the agent first if it's down (must be a known agent, so typos error not spawn)
#   - health = pane runs a non-shell foreground command, not mere session existence
#   - no eval on config content
set -euo pipefail

CONF="${SQUAD_CONF:-$HOME/.config/squad/squad.conf}"
SOCK="${SQUAD_SOCKET:-squad}"            # dedicated tmux socket (namespaces the whole squad)
SLICE="${SQUAD_SLICE:-}"                 # optional systemd user slice for ceilings; empty = none
OPS_DIR="$HOME/SoftwareProjects"
CMD="$(basename "$0")"                   # whatever you symlinked this as (help text only)
SELF="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"   # real script path (for tmux key bindings)

tm() { command tmux -L "$SOCK" "$@"; }   # NB: never a var named TMUX (tmux reserves it)

# ---- config (agent|worktree|gh_config_dir|claude_args ; gh_config_dir may be empty) ----
rows()   { grep -vE '^[[:space:]]*(#|$)' "$CONF" 2>/dev/null || true; }
agents() { rows | cut -d'|' -f1; }
field()  { rows | awk -F'|' -v a="$1" -v n="$2" '$1==a {print $n; exit}'; }
untilde(){ printf '%s\n' "${1/#\~/$HOME}"; }
# Resolve an agent name: an explicit arg always wins; otherwise derive it from
# $PWD by matching against each agent's worktree — so running a verb from inside
# a worktree targets that worktree's agent with no name typed. Prints the name
# on success; returns non-zero (no output) if no arg and $PWD isn't under any
# worktree. Trailing-slash compare so /foo doesn't match worktree /foobar.
resolve_agent() {
  if [ -n "${1:-}" ]; then printf '%s\n' "$1"; return 0; fi
  local cwd a dir
  cwd="$(pwd -P 2>/dev/null || printf '%s' "$PWD")"
  for a in $(agents); do
    dir="$(untilde "$(field "$a" 2)")"
    [ -d "$dir" ] && dir="$(cd "$dir" 2>/dev/null && pwd -P)"
    [ -n "$dir" ] || continue
    case "$cwd/" in "$dir"/*) printf '%s\n' "$a"; return 0 ;; esac
  done
  return 1
}

# resolve_agent + validate it's a real roster entry. The cwd-default that every
# agent-taking verb shares flows through here. Errors go to stderr (so command
# substitution captures only the resolved name); callers use `|| exit 1`.
need_agent() {
  local a
  a="$(resolve_agent "${1:-}")" || {
    echo "!! no agent given and \$PWD isn't inside any squad worktree — name one (see $CONF)" >&2; return 1; }
  field "$a" 1 | grep -qxF -- "$a" || { echo "!! unknown agent '$a' (see $CONF)" >&2; return 1; }
  printf '%s\n' "$a"
}

# No dedicated "ops" session — the first agent's new-session bootstraps the tmux server (see up_one).

# NB: pane-target commands (send-keys / display-message / capture) do NOT accept the "=" exact-match
# prefix on tmux 3.4 — only session-target commands (has-session / kill-session / attach) do. So we
# use the bare name here (exact-match still wins: tmux tries exact before fnmatch/prefix).
pane_cmd()   { tm display-message -p -t "$1" '#{pane_current_command}' 2>/dev/null || true; }
pane_alive() { local c; c="$(pane_cmd "$1")"; [ -n "$c" ] && [ "$c" != bash ] && [ "$c" != sh ] && [ "$c" != zsh ]; }

type_line() { local t="$1"; shift; tm send-keys -t "$t" -l "$*"; sleep 0.2; tm send-keys -t "$t" Enter; }

# What is this agent's claude doing RIGHT NOW? Reads the pane's visible text —
# the permission dialog / input prompt is on screen when claude is blocked, so
# the screen is the source of truth no notification channel can lie about.
#   waiting = a dialog/prompt needs the operator   working = mid-turn   idle = between turns
classify_agent() {
  local tail
  # NB: capture-pane is a pane-target command — no "=" prefix (see top note)
  tail="$(tm capture-pane -p -t "$1" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -20)"
  # [X] char-class trick: these patterns must never match their own source
  # (the hub agent edits this file — its pane shows these lines mid-diff)
  if   printf '%s\n' "$tail" | grep -qE '❯ 1\. [Y]es|[D]o you want to|[N]o, and tell Claude|requires [a]pproval'; then printf 'waiting'
  elif printf '%s\n' "$tail" | grep -qE '[e]sc to interrupt'; then printf 'working'
  else printf 'idle'; fi
}

# Per-agent hub state files under ~/.mcp-hub, named with the same sanitisation
# the daemon uses (non [A-Za-z0-9_-] -> _). status-*.json is the daemon's
# wakeability snapshot; heartbeat-*.pid is its singleton claim.
safe_name()    { printf '%s' "$1" | sed 's/[^A-Za-z0-9_-]/_/g'; }
status_file()  { printf '%s\n' "$HOME/.mcp-hub/status-$(safe_name "$1").json"; }
pidfile()      { printf '%s\n' "$HOME/.mcp-hub/heartbeat-$(safe_name "$1").pid"; }

# Remove --continue from an args string (one-off --fresh restarts).
strip_continue() { printf '%s\n' "$1" | sed -E 's/(^|[[:space:]])--continue([[:space:]]+|$)/\1/g; s/^[[:space:]]+//; s/[[:space:]]+$//'; }

# Type the launch sequence (GH env + claude + channels confirm-dance) into an
# agent's existing pane. Shared by up_one (fresh session) and restart (respawn
# in place). An optional 2nd arg overrides the roster's claude_args for THIS
# launch only (restart --fresh/--resume); the roster is never touched.
launch_agent_cmd() {
  local a="$1" ghdir args
  ghdir="$(untilde "$(field "$a" 3)")"
  if [ $# -ge 2 ]; then args="$2"; else args="$(field "$a" 4)"; fi
  [ -n "$ghdir" ] && type_line "$a" "export GH_CONFIG_DIR=\"$ghdir\""
  type_line "$a" "claude $args"
  echo "started $a  ($args)"
  # --dangerously-load-development-channels pops a confirm prompt on launch; auto-accept it
  # (server:hub is your own hub = the "local development" case; option 1 is the default → Enter).
  case "$args" in *dangerously-load-development-channels*)
    for _ in $(seq 1 10); do sleep 1
      tm capture-pane -t "$a" -p 2>/dev/null | grep -qi 'channel development' && { tm send-keys -t "$a" Enter; break; }
    done ;;
  esac
}

up_one() {
  local a="$1" dir
  dir="$(untilde "$(field "$a" 2)")"
  [ -d "$dir" ] || { echo "!! $a: missing worktree $dir"; return 1; }
  if tm has-session -t "=$a" 2>/dev/null; then
    if pane_alive "$a"; then echo "$a already up"
    else echo "!! $a: session exists but claude is NOT running — try: $CMD restart $a"; fi
    return 0
  fi
  # new-session bootstraps the tmux server on first launch; wrap under the slice if one is configured
  if [ -n "$SLICE" ] && ! tm list-sessions >/dev/null 2>&1 && systemctl --user list-unit-files 2>/dev/null | grep -q "^$SLICE"; then
    systemd-run --user --slice="$SLICE" --scope -q tmux -L "$SOCK" new-session -d -s "$a" -c "$dir"
  else
    tm new-session -d -s "$a" -c "$dir"
  fi
  if [ $# -ge 2 ]; then launch_agent_cmd "$a" "$2"; else launch_agent_cmd "$a"; fi
}

org_alias() {
  case "$1" in
    dreamteam-ai-labs) echo "github-dreamteam" ;;
    monkeypashion)     echo "github-monkeypashion" ;;
    byte-hound)        echo "github-byte-hound" ;;
    *) return 1 ;;
  esac
}

pull_local() {
  local spec="$1" org repo alias parent dest
  org="${spec%%/*}"; repo="${spec#*/}"; repo="${repo%.git}"
  [ "$org" != "$spec" ] && [ -n "$repo" ] || { echo "usage: $CMD pull-local <org>/<repo>"; return 1; }
  alias="$(org_alias "$org")" || { echo "!! unknown org '$org'"; return 1; }
  parent="$HOME/SoftwareProjects/$org"; dest="$parent/$repo"; mkdir -p "$parent"
  if [ -d "$dest/.git" ]; then git -C "$dest" pull --ff-only; else git clone "git@$alias:$org/$repo.git" "$dest"; fi
  echo "$dest"
}

# Mirror of cli.py _sanitize_ident: lowercase, non [a-z0-9_-] -> '-', trim '-'.
sanitize_ident() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9_-]/-/g' -e 's/^-*//' -e 's/-*$//'; }

# Opt org/repo in/out of ~/.mcp-hub/config.json's projects list (idempotent).
# Identity is DERIVED by the hub cli (repo-hostname / org/repo from the git
# remote); this machine-local list is the only thing that opts a repo in.
# Users never edit it — add/rm maintain it.
optin_project() {
  local verb="$1" proj="$2" cfg="$HOME/.mcp-hub/config.json"
  mkdir -p "$HOME/.mcp-hub"
  python3 - "$cfg" "$verb" "$proj" <<'PYEOF'
import json, pathlib, sys
cfg, verb, proj = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3]
try:
    data = json.loads(cfg.read_text(encoding="utf-8"))
    assert isinstance(data, dict)
except Exception:
    data = {}
projects = data.get("projects")
if not isinstance(projects, list):
    projects = []
changed = False
if verb == "add" and proj not in projects:
    projects.append(proj); changed = True
    print(f"hub opt-in: {proj}")
elif verb == "remove" and proj in projects:
    projects.remove(proj); changed = True
    print(f"hub opt-out: {proj}")
if changed:
    data["projects"] = projects
    cfg.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
PYEOF
}

# org/repo derived from a worktree's git remote (empty on failure) — mirrors
# cli.py _parse_org_repo (URL path only, so SSH aliases resolve identically).
worktree_project() {
  local url
  url="$(git -C "$1" remote get-url origin 2>/dev/null)" || return 0
  printf '%s\n' "$url" | sed -e 's/\.git$//' -e 's#/$##' \
    | awk '{ if (match($0, "://")) { sub(".*://[^/]*/", "") } else if (match($0, ":")) { sub("[^:]*:", "") } n=split($0, p, "/"); if (n>=2) print p[n-1] "/" p[n] }'
}

# Migrate a legacy roster line: same worktree enrolled under a different
# (pre-derived-identity) name -> rename the line and any live tmux session.
migrate_roster_name() {
  local dest="$1" derived="$2" old
  old="$(rows | awk -F'|' -v d="$dest" '$2==d && $1!="" {print $1; exit}')"
  [ -n "$old" ] && [ "$old" != "$derived" ] || return 0
  tmp="$(mktemp)"; awk -F'|' -v o="$old" -v n="$derived" 'BEGIN{OFS="|"} $1==o{$1=n} {print}' "$CONF" > "$tmp" && mv "$tmp" "$CONF"
  tm rename-session -t "=$old" "$derived" 2>/dev/null && echo "renamed live session: $old -> $derived"
  # retire old-name daemon state; the Stop-hook self-heal starts the new one
  local safe; safe="$(printf '%s' "$old" | sed 's/[^A-Za-z0-9_-]/_/g')"
  [ -f "$HOME/.mcp-hub/heartbeat-$safe.pid" ] && kill "$(cat "$HOME/.mcp-hub/heartbeat-$safe.pid" 2>/dev/null)" 2>/dev/null
  rm -f "$HOME/.mcp-hub/heartbeat-$safe.pid" "$HOME/.mcp-hub/status-$safe.json"
  echo "migrated roster: $old -> $derived"
}

add_agent() {  # squad add <org>/<repo> — clone/pull, opt in, enroll/migrate under the DERIVED name
  local spec="$1" out dest name
  [[ "$spec" == ?*/?* ]] || { echo "usage: $CMD add <org>/<repo>"; return 1; }
  [ -z "${2:-}" ] || echo "note: identity is derived (<repo>-<hostname>); extra args ignored"
  out="$(pull_local "$spec")" || return 1          # clones/pulls; last line is the dest path
  dest="$(printf '%s\n' "$out" | tail -1)"
  [ -d "$dest" ] || { echo "!! clone failed for $spec"; return 1; }
  # derived identity: name = <repo>-<hostname>, project = <org>/<repo>
  name="$(sanitize_ident "$(basename "$dest")-$(hostname)")"
  optin_project add "${spec%.git}"
  migrate_roster_name "$dest" "$name"              # legacy-name line for this worktree -> derived
  if agents | grep -qxF -- "$name"; then echo "'$name' enrolled -> $dest"; return 0; fi
  mkdir -p "$(dirname "$CONF")"
  printf '%s|%s||--dangerously-load-development-channels server:hub\n' "$name" "$dest" >> "$CONF"
  echo "enrolled '$name' -> $dest"
  echo "  run: $CMD restart $name   (or $CMD up)  to launch it"
}

rm_agent() {   # squad rm [agent] — exact inverse of add: session, roster, opt-in, daemon state
  local a="$1" dir proj safe
  dir="$(untilde "$(field "$a" 2)")"
  tm kill-session -t "=$a" 2>/dev/null || true
  tmp="$(mktemp)"; awk -F'|' -v a="$a" '$1!=a' "$CONF" > "$tmp" && mv "$tmp" "$CONF"
  # opt the project back out so hooks go silent for this repo again
  if [ -d "$dir" ]; then
    proj="$(worktree_project "$dir")"
    [ -n "$proj" ] && optin_project remove "$proj"
  fi
  # retire daemon + state files
  safe="$(printf '%s' "$a" | sed 's/[^A-Za-z0-9_-]/_/g')"
  [ -f "$HOME/.mcp-hub/heartbeat-$safe.pid" ] && kill "$(cat "$HOME/.mcp-hub/heartbeat-$safe.pid" 2>/dev/null)" 2>/dev/null
  rm -f "$HOME/.mcp-hub/heartbeat-$safe.pid" "$HOME/.mcp-hub/status-$safe.json"
  echo "removed '$a' (session, roster, hub opt-in, daemon) — repo left in place"
}

handoff() {
  local a="$1" dir cur
  dir="$(untilde "$(field "$a" 2)")"; cur="$(git -C "$dir" branch --show-current)"
  if ! git -C "$dir" diff --quiet || ! git -C "$dir" diff --cached --quiet || [ -n "$(git -C "$dir" ls-files --others --exclude-standard)" ]; then
    local wip="wip/$a-$(date +%Y%m%d-%H%M)"
    git -C "$dir" checkout -b "$wip"; git -C "$dir" add -A; git -C "$dir" commit -m "WIP handoff ($a)"; git -C "$dir" push -u origin "$wip"
    echo "$a: WIP pushed on $wip (from $cur)"
  else
    git -C "$dir" push origin "$cur" 2>/dev/null || true; echo "$a: clean — pushed $cur"
  fi
}

# Agent-taking verbs omit the name to mean "the agent for $PWD" (need_agent).
# For cmd/key/args the first token is the agent ONLY if it's a known roster
# name (or `all`); otherwise it's treated as payload and the agent is $PWD's.
case "${1:-help}" in
  up)       for a in $(agents); do up_one "$a"; done ;;
  restart)  shift; mode=""; a_arg=""
            for t in "$@"; do case "$t" in
              --fresh)  mode=fresh ;;
              --resume) mode=resume ;;
              -*) echo "!! unknown restart flag '$t' (valid: --fresh, --resume)" >&2; exit 1 ;;
              *)  a_arg="$t" ;;
            esac; done
            a="$(need_agent "$a_arg")" || exit 1
            # One-off launch-args override — the roster is never modified here.
            rargs="$(field "$a" 4)"
            case "$mode" in
              fresh)  rargs="$(strip_continue "$rargs")" ;;
              resume) case "$rargs" in *--continue*) ;; *) rargs="--continue $rargs" ;; esac ;;
            esac
            if tm has-session -t "=$a" 2>/dev/null; then
              # Respawn IN PLACE: kills the pane's process and gives it a fresh
              # shell, but the session survives — attached viewers keep watching
              # instead of being dumped to their own shell mid-restart.
              # -c: ALWAYS the roster worktree — never trust the session's
              # stored path (2026-07-19: parallel-attach race crossed two
              # sessions' names/paths; explicit -c makes restarts self-healing).
              tm respawn-pane -k -c "$(untilde "$(field "$a" 2)")" -t "$a"
              # pane title and scrollback are sticky — clear both so the dead
              # conversation can't impersonate the new one (stale title +
              # scroll-up history made --fresh look like it hadn't worked)
              tm select-pane -t "$a" -T '' 2>/dev/null || true
              tm clear-history -t "$a" 2>/dev/null || true
              sleep 0.5
              if [ -n "$mode" ]; then launch_agent_cmd "$a" "$rargs"; else launch_agent_cmd "$a"; fi
            else
              if [ -n "$mode" ]; then up_one "$a" "$rargs"; else up_one "$a"; fi
            fi ;;
  down)     tm kill-server 2>/dev/null || true
            # The keep-alive daemons are detached (they outlive tmux), so kill
            # them explicitly via their pidfiles and clear the stale claim.
            for a in $(agents); do
              pf="$(pidfile "$a")"
              [ -f "$pf" ] && kill "$(cat "$pf" 2>/dev/null)" 2>/dev/null && rm -f "$pf"
            done ;;
  heal)     # Recovery for agents that are UP in tmux but broken on the hub:
            #   offline     -> binding lost (redeploy/reconnect): nudge register()
            #   unwakeable  -> online but wake-stream dead: nudge, and if STILL
            #                  bad on the next heal pass (flag file <10m) AND the
            #                  agent launches with --continue (restart preserves
            #                  its conversation), RESTART it in place.
            # Fresh snapshots only (<3m) so a stale/missing cache never triggers.
            healed=0
            for a in $(agents); do
              tm has-session -t "=$a" 2>/dev/null || continue
              pane_alive "$a" || continue
              sf="$(status_file "$a")"
              flag="$HOME/.mcp-hub/heal-flag-$(safe_name "$a")"
              [ -n "$(find "$sf" -mmin -3 2>/dev/null)" ] || continue   # snapshot fresh (<3m)?
              state=""
              if grep -q '"online"[[:space:]]*:[[:space:]]*false' "$sf" 2>/dev/null; then state="offline"
              elif grep -q '"wakeable"[[:space:]]*:[[:space:]]*false' "$sf" 2>/dev/null; then state="unwakeable"
              fi
              if [ -z "$state" ]; then rm -f "$flag"; continue; fi   # healthy — clear strikes
              args="$(field "$a" 4)"
              if [ -n "$(find "$flag" -mmin -10 2>/dev/null)" ] && [[ "$args" == *--continue* ]]; then
                echo "$a: STILL $state after a nudge — restarting in place (--continue keeps context)"
                tm respawn-pane -k -c "$(untilde "$(field "$a" 2)")" -t "$a"; sleep 0.5; launch_agent_cmd "$a"
                rm -f "$flag"
              else
                echo "$a: $state on hub — nudging re-register"
                type_line "$a" "hub: your session shows $state. Call register() now to rebind. If this recurs, your wake-stream is dead — re-register won't fix it; a relaunch will (squad restart resumes your conversation)."
                touch "$flag"
              fi
              healed=$((healed+1))
            done
            [ "$healed" = 0 ] && echo "all up agents healthy — nothing to heal" || true ;;
  cmd)      if [ "${2:-}" = all ]; then shift 2; for a in $(agents); do type_line "$a" "$@"; done
            elif [ -n "${2:-}" ] && agents | grep -qxF -- "${2:-}"; then a="$2"; shift 2; type_line "$a" "$@"
            else a="$(need_agent "")" || exit 1; shift
                 [ -n "${1:-}" ] || { echo "usage: $CMD cmd [agent|all] \"text\"" >&2; exit 1; }
                 type_line "$a" "$@"; fi ;;
  key)      if [ -n "${2:-}" ] && agents | grep -qxF -- "${2:-}"; then t="$2"; shift 2; tm send-keys -t "$t" "$@"
            else t="$(need_agent "")" || exit 1; shift
                 [ -n "${1:-}" ] || { echo "usage: $CMD key [agent] <keys>" >&2; exit 1; }
                 tm send-keys -t "$t" "$@"; fi ;;
  attach)   a="$(need_agent "${2:-}")" || exit 1
            if ! tm has-session -t "=$a" 2>/dev/null; then
              echo "$a not running — starting it..."; up_one "$a"; sleep 1
            elif ! pane_alive "$a"; then
              echo "$a was degraded — restarting claude..."; tm kill-session -t "=$a" 2>/dev/null || true; up_one "$a"; sleep 1
            fi
            if [ -n "${TMUX:-}" ]; then           # already inside tmux — switch, don't nest
              tmux -L "$SOCK" switch-client -t "=$a" 2>/dev/null \
                || { echo "you're inside a different tmux — detach first (Ctrl-b d), then: $CMD attach $a"; exit 1; }
            else
              exec tmux -L "$SOCK" attach -t "=$a"
            fi ;;
  ls)       # tmux liveness + hub presence (from the daemon's status snapshot)
            hub_state() {
              local safe sf
              safe="$(printf '%s' "$1" | sed 's/[^A-Za-z0-9_-]/_/g')"; sf="$HOME/.mcp-hub/status-$safe.json"
              [ -f "$sf" ] || { printf -- '-'; return; }
              [ -n "$(find "$sf" -mmin -3 2>/dev/null)" ] || { printf 'hub?'; return; }
              if grep -q '"online"[[:space:]]*:[[:space:]]*true' "$sf"; then
                if grep -q '"wakeable"[[:space:]]*:[[:space:]]*true' "$sf"; then printf '⚡ online'; else printf 'online'; fi
              else printf '✖ offline'; fi
            }
            printf '%-26s %-10s %-11s %s\n' 'AGENT' 'TMUX' 'HUB' ''
            for a in $(agents); do
              if tm has-session -t "=$a" 2>/dev/null; then
                if pane_alive "$a"; then printf '%-26s %-10s %-11s (%s)\n' "$a" up "$(hub_state "$a")" "$(pane_cmd "$a")"
                else printf '%-26s %-10s %-11s session up, claude not running — try: %s restart %s\n' "$a" DEGRADED "$(hub_state "$a")" "$CMD" "$a"; fi
              else printf '%-26s %-10s %-11s\n' "$a" down "$(hub_state "$a")"; fi
            done ;;
  args)     if [ -n "${2:-}" ] && agents | grep -qxF -- "${2:-}"; then a="$2"; shift 2
            else a="$(need_agent "")" || exit 1; shift; fi
            tmp="$(mktemp)"; awk -F'|' -v a="$a" -v n="$*" 'BEGIN{OFS="|"} $1==a{$4=n} {print}' "$CONF" > "$tmp" && mv "$tmp" "$CONF"
            echo "next launch of $a: $*" ;;
  dash)     # The whole-squad monitor: ONE window, one live pane per agent, tiled.
            # Recreates the old "seven VSCode windows on one monitor" view in a
            # single command. Each pane is a nested tmux client attached to that
            # agent's session on this same server — so it's the agent's REAL pane
            # (type into it to talk to that agent), not a read-only copy.
            #   dash              -> every enrolled agent
            #   dash a b c        -> ad-hoc mini-squad of just those agents
            #   dash --pick       -> popup multi-select list (TAB marks, Enter builds)
            # Ctrl-b g reopens the picker from inside the dash (bound on build).
            # "dash" is a reserved session name (like "ops") — don't name an agent dash.
            shift
            pick=""; noattach=""
            while [ $# -gt 0 ]; do case "$1" in
              --pick)      pick=1; shift ;;
              --no-attach) noattach=1; shift ;;   # internal (Ctrl-b g binding): rebuild only —
                                                  # attaching from inside the popup would add a
                                                  # popup-sized client and shrink the whole dash
              *) break ;;
            esac; done
            if [ -n "$pick" ]; then
              command -v fzf >/dev/null 2>&1 || { echo "!! dash --pick needs fzf (apt install fzf)" >&2; exit 1; }
              sel="$(agents | fzf --multi --reverse --prompt='dash agents> ' \
                     --header='TAB marks/unmarks agents · Enter builds the dash · Esc cancels')" || exit 0
              [ -n "$sel" ] || exit 0
              # shellcheck disable=SC2086 — agent names are sanitized, never contain spaces
              set -- $sel
            elif [ $# -gt 0 ]; then
              for t in "$@"; do agents | grep -qxF -- "$t" || { echo "!! unknown agent '$t' (see $CONF)" >&2; exit 1; }; done
            else
              set -- $(agents)
            fi
            d="dash"
            # With several clients on one session (a dash pane + a direct attach),
            # follow the most recently active client's size instead of clamping
            # every view to the smallest one.
            tm set -g window-size latest 2>/dev/null || true
            for a in "$@"; do tm has-session -t "=$a" 2>/dev/null || up_one "$a"; done
            # Rebuild IN PLACE — never kill the dash session. Attached viewers
            # must survive a re-scope, and the Ctrl-b g picker popup literally
            # lives on this session: kill-session would detach the viewer
            # ("[exited]", via detach-on-destroy) and SIGHUP the picker script
            # mid-rebuild, leaving a dead or half-built dash.
            # NB: kill-pane/respawn-pane/split-window/select-layout are
            # pane-target commands — no "=" prefix (see top note).
            if tm has-session -t "=$d" 2>/dev/null; then
              tm kill-pane -a -t "$d" 2>/dev/null || true     # prune to the active pane
              tm respawn-pane -k -t "$d" "TMUX= exec tmux -L $SOCK attach -t '=$1'"
            else
              # -x/-y: generous canvas so all splits fit while detached; the
              # window re-sizes to the real client on attach (window-size latest).
              tm new-session -d -s "$d" -x 220 -y 60 "TMUX= exec tmux -L $SOCK attach -t '=$1'"
            fi
            # tag each tile with its agent so `who` can paint borders by state
            tm set -p -t "$(tm display -p -t "$d" '#{pane_id}')" @agent "$1"
            first=1
            for a in "$@"; do
              [ -n "$first" ] && { first=""; continue; }      # $1 already placed above
              p="$(tm split-window -t "$d" -dP -F '#{pane_id}' "TMUX= exec tmux -L $SOCK attach -t '=$a'")"
              tm set -p -t "$p" @agent "$a"
              tm select-layout -t "$d" tiled >/dev/null
            done
            tm select-layout -t "$d" tiled >/dev/null
            # Ctrl-b g: popup picker to re-scope the dash live from inside it
            tm bind-key g display-popup -E -w 44 -h 60% "'$SELF' dash --pick --no-attach" 2>/dev/null || true
            echo "dash: $# agent(s) tiled — Ctrl-b z zoom · Ctrl-b g pick agents · Ctrl-b arrows move focus"
            [ -n "$noattach" ] && exit 0
            if [ -n "${TMUX:-}" ]; then
              tmux -L "$SOCK" switch-client -t "=$d" 2>/dev/null \
                || echo "attach with: $CMD dash   (or Ctrl-b s and pick 'dash')"
            else
              exec tmux -L "$SOCK" attach -t "=$d"
            fi ;;
  answer)   # squad answer [agent] yes|always|no — answer the approval dialog
            # on that agent's screen with one keystroke. SAFE: parses the
            # dialog's actual numbered options and presses the digit whose
            # label matches the intent; numbering shifts between dialogs
            # (2 can be "always" or "No"), so blind digits are never sent.
            # Fail-closed: no visible matching option -> error, no keypress.
            a="$(need_agent "${2:-}")" || exit 1
            intent="${3:-yes}"
            # NB: capture-pane is a pane-target command — no "=" prefix
            # every grep shielded with `|| true` — under set -e a no-match grep
            # in a $() assignment kills the script before the fail-closed
            # message can print. "ask again" (not "don't") dodges the curly
            # apostrophe the dialogs actually use.
            lines="$(tm capture-pane -p -t "$a" 2>/dev/null | tail -25 | grep -E '^[[:space:]]*(❯[[:space:]]*)?[0-9]+\.' || true)"
            case "$intent" in
              yes)    line="$(printf '%s\n' "$lines" | grep -iE '[0-9]+\.[[:space:]]*yes' | grep -ivE "ask again|always" | head -1 || true)" ;;
              always) line="$(printf '%s\n' "$lines" | grep -iE "ask again|yes.*always" | head -1 || true)" ;;
              no)     line="$(printf '%s\n' "$lines" | grep -iE '[0-9]+\.[[:space:]]*no' | head -1 || true)" ;;
              *) echo "usage: $CMD answer [agent] yes|always|no" >&2; exit 1 ;;
            esac
            num="$(printf '%s\n' "$line" | grep -oE '[0-9]+' | head -1 || true)"
            [ -n "$num" ] || { echo "!! $a: no '$intent' option on screen — not waiting, or dialog has no such choice" >&2; exit 1; }
            tm send-keys -t "$a" "$num"
            echo "$a: answered '$intent' (option $num: $(printf '%s' "$line" | sed 's/^[[:space:]❯]*//'))" ;;
  who)      # Who needs YOU? Reads every agent's screen and reports: 🔴 waiting
            # on operator input · 🟢 working · 💤 idle. With -w/--watch, loops
            # every 2s and also paints dash tile borders (red/green/grey) so
            # the dash doubles as the needs-me board.
            wmode=""; case "${2:-}" in -w|--watch) wmode=1 ;; esac
            declare -A WST   # agent -> state, one classify pass per refresh
            # Compact hub-presence glyph from the daemon's status cache (same
            # source as the statusline / `ls` HUB column):
            #   ⚡ wakeable · ⚠ online but unwakeable · ✖ offline · ? stale · '' no data
            hub_glyph() {
              local sf; sf="$(status_file "$1")"
              [ -f "$sf" ] || { printf '?'; return; }
              [ -n "$(find "$sf" -mmin -3 2>/dev/null)" ] || { printf '?'; return; }
              if grep -q '"online"[[:space:]]*:[[:space:]]*true' "$sf"; then
                if grep -q '"wakeable"[[:space:]]*:[[:space:]]*true' "$sf"; then printf '⚡'; else printf '⚠'; fi
              else printf '✖'; fi
            }
            declare -A WCTX  # agent -> context % (scraped from its own statusline)
            who_board() {
              local a st g tail ctx
              for a in $(agents); do
                ctx=""
                if ! tm has-session -t "=$a" 2>/dev/null || ! pane_alive "$a"; then st="down"
                else
                  # one capture, two harvests: waiting/working state AND the
                  # ctx % the agent's own statusline already renders on screen
                  tail="$(tm capture-pane -p -t "$a" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -20)"
                  if   printf '%s\n' "$tail" | grep -qE '❯ 1\. [Y]es|[D]o you want to|[N]o, and tell Claude|requires [a]pproval'; then st="waiting"
                  elif printf '%s\n' "$tail" | grep -qE '[e]sc to interrupt'; then st="working"
                  else st="idle"; fi
                  ctx="$(printf '%s\n' "$tail" | grep -oE '[c]tx \[[^]]*\][[:space:]]*[0-9]+%' | tail -1 | grep -oE '[0-9]+%' || true)"
                fi
                WST[$a]="$st"
                # sticky: a capture racing the agent's redraw sometimes misses
                # the statusline — keep the last reading rather than blinking
                # the % out of the title (title churn = visible tab flicker).
                # BUT an empty pane title means a just-restarted claude
                # (restart clears it) — drop the dead session's cached %.
                if [ -n "$ctx" ]; then WCTX[$a]="$ctx"
                elif [ "$st" = "down" ] || [ -z "$(tm display -p -t "$a" '#{pane_title}' 2>/dev/null)" ]; then WCTX[$a]=""
                fi
                g="$(hub_glyph "$a")"
                case "$st" in
                  waiting) printf '  \033[1;31m🔴 %-28s %-2s %-4s WAITING ON YOU\033[0m\n' "$a" "$g" "$ctx" ;;
                  working) printf '  \033[32m🟢 %-28s %-2s %-4s working\033[0m\n' "$a" "$g" "$ctx" ;;
                  idle)    printf '  \033[2m💤 %-28s %-2s %-4s idle\033[0m\n' "$a" "$g" "$ctx" ;;
                  down)    printf '  ⚫ %-28s %-2s %-4s down\n' "$a" "$g" "$ctx" ;;
                esac
              done
            }
            who_paint() {   # dash borders mirror the board (no-op without a dash)
              tm has-session -t "=dash" 2>/dev/null || return 0
              local p ag
              for p in $(tm list-panes -t dash -F '#{pane_id}'); do
                ag="$(tm display -p -t "$p" '#{@agent}' 2>/dev/null)"
                [ -n "$ag" ] || continue
                case "${WST[$ag]:-}" in
                  waiting) tm select-pane -t "$p" -P 'fg=red,bold' ;;
                  working) tm select-pane -t "$p" -P 'fg=green' ;;
                  *)       tm select-pane -t "$p" -P 'fg=colour240' ;;
                esac
              done
            }
            who_badge() {   # State -> VSCode tab, two channels per agent:
              # 1. per-session set-titles-string prefix: 🔴 lands INSIDE the
              #    grey ${sequence} text (proven to render in plain terminals).
              #    Waiting agents alternate a trailing space so the title
              #    CHANGES every pass — tmux only re-pushes on change, and a
              #    fresh window needs a push before it shows anything.
              # 2. OSC 9;4 progress straight to the client tty (rendered by
              #    ${progress} where supported; harmless where not).
              # The short agent label is baked into the title because the
              # VSCode terminals are UNNAMED (a fixed name suppresses live
              # titles) — the title IS the tab name: "dt ⚡ · ✳ <status>".
              # Re-push discipline: tmux transmits only on change; content
              # changes (#T, state, glyph) push themselves. A trailing-space
              # jiggle forces a push ONLY when a new client appears (fresh
              # window needs a backfill) or on a slow ~60s heartbeat —
              # constant alternation made tabs visibly flicker every pass.
              local a tty seq ts sp='' hostsafe short g cur jig=''
              hostsafe="$(sanitize_ident "$(hostname)")"
              cur="$(tm list-clients -F '#{client_tty}' 2>/dev/null | sort | paste -sd, -)"
              [ "$cur" != "$WHO_LAST" ] && jig=1; WHO_LAST="$cur"
              WHO_PASS=$((WHO_PASS+1)); [ $(( WHO_PASS % 30 )) = 0 ] && jig=1
              [ -n "$jig" ] && sp=' '
              local ctx
              for a in $(agents); do
                short="${a%-$hostsafe}"
                # glyph FIRST (right after the tab icon) so the status column
                # lines up; 🔴 slots in after it when waiting — the name
                # jumping right is deliberate attention-grabbing. ctx % rides
                # after the label: "⚡ dt 44% · ✳ <status>".
                g="$(hub_glyph "$a")"
                ctx="${WCTX[$a]:-}"
                # context-pressure tiers (titles can't carry ANSI colour):
                # operator clears context before 50% — plain <40 · 🟡 40-49 ·
                # 🔥 50+  (🔴 stays "waiting", ⚠ stays hub)
                if [ -n "$ctx" ]; then
                  n="${ctx%\%}"
                  if   [ "$n" -ge 50 ] 2>/dev/null; then ctx="🔥$ctx"
                  elif [ "$n" -ge 40 ] 2>/dev/null; then ctx="🟡$ctx"; fi
                fi
                case "${WST[$a]:-}" in
                  waiting) ts="$g 🔴 $short${ctx:+ $ctx} · #T$sp"; seq='\033]9;4;2;0\a' ;;
                  working) ts="$g $short${ctx:+ $ctx} · #T$sp";    seq='\033]9;4;3;0\a' ;;
                  *)       ts="$g $short${ctx:+ $ctx} · #T$sp";    seq='\033]9;4;0;0\a' ;;
                esac
                # NB: show/set-option reject the "=" prefix too — bare name
                [ "$(tm show -t "$a" -v set-titles-string 2>/dev/null)" = "$ts" ] \
                  || tm set -t "$a" set-titles-string "$ts" 2>/dev/null || true
                for tty in $(tm list-clients -t "=$a" -F '#{?#{==:#{client_termname},xterm-256color},#{client_tty},}' 2>/dev/null); do
                  [ -w "$tty" ] && printf '%b' "$seq" > "$tty" 2>/dev/null || true
                done
              done
            }
            WHO_PASS=0; WHO_LAST=''
            if [ -n "$wmode" ]; then
              while true; do
                printf '\033[2J\033[H'
                printf 'squad who — %s   (🔴 needs you · 🟢 working · 💤 idle · ⚡ wakeable)\n\n' "$(date +%H:%M:%S)"
                who_board; who_paint; who_badge; sleep 2
              done
            else who_board; who_paint; who_badge; fi ;;
  handoff)  a="$(need_agent "${2:-}")" || exit 1; handoff "$a" ;;
  add)      add_agent "${2:-}" "${3:-}" "${4:-}" ;;
  rm)       a="$(need_agent "${2:-}")" || exit 1; rm_agent "$a" ;;
  pull-local) pull_local "${2:-}" ;;
  *) cat <<EOF
squad — run this machine's squad of Claude Code agents in tmux, wired to the mcp-hub.
(terminology: a "squad" is one machine's agents; the "fleet" is every agent on the hub, all machines.)

enroll (identity is derived: name = <repo>-<hostname>, project = <org>/<repo>)
  $CMD add <org>/<repo>         clone/pull + hub opt-in + enroll (idempotent; migrates legacy names)
  $CMD rm  [agent]              inverse of add: session, roster, hub opt-in, daemon (repo kept)

run
  $CMD up                       start every enrolled agent (idempotent)
  $CMD down                     stop everything (tmux server + keep-alive daemons)
  $CMD restart [agent] [--fresh|--resume]
                                relaunch claude in place (attached viewers keep watching)
                                  no flag:   launch with the agent's roster args as-is
                                  --resume:  add --continue this once (resume last conversation)
                                  --fresh:   drop --continue this once (start a blank conversation)
                                the roster is never modified — use 'args' to change the default
  $CMD attach  [agent]          attach, starting/repairing it first if needed; Ctrl-b d detaches

watch + repair
  $CMD dash [agent...|--pick]   the squad in ONE window — a live tiled pane per agent
                                (starts any that are down). no args: everyone; name agents
                                for an ad-hoc mini-squad; --pick: multi-select list
                                (TAB marks, Enter builds). inside the dash:
                                  type into a pane        talk to that agent
                                  Ctrl-b g                reopen the agent picker (popup)
                                  Ctrl-b z                zoom/unzoom the focused agent
                                  Ctrl-b arrows           move focus  (mouse works too)
                                  Ctrl-b Ctrl-b           pass a Ctrl-b through to the agent
  $CMD answer [agent] yes|always|no
                                answer the approval dialog on an agent's screen — parses the
                                visible options and presses the matching digit (fail-closed:
                                refuses when no matching option is on screen)
  $CMD who [-w]                 who needs YOU: 🔴 waiting on your input · 🟢 working · 💤 idle
                                (reads each agent's screen). -w: refresh every 2s and paint
                                dash tile borders to match — red border = agent is blocked on you
  $CMD ls                       status: tmux liveness + hub presence per agent
  $CMD heal                     fix agents that are up in tmux but broken on the hub:
                                first pass nudges the agent to re-register; if still broken
                                on the next pass it auto-restarts — but ONLY agents whose
                                roster args include --continue (so no conversation is lost).
                                a systemd user timer (squad-heal.timer) runs this every 2 min.

interact
  $CMD cmd [agent|all] "..."    type text + Enter into session(s)   e.g. $CMD cmd all "/compact"
  $CMD key [agent] <keys>       raw tmux send-keys (no Enter appended)
  $CMD args [agent] "..."       set the agent's DEFAULT launch args (roster; used by up/restart/heal)
  $CMD handoff [agent]          commit WIP to wip/<agent>-<date> + push (before switching machines)

helpers
  $CMD pull-local <org>/<repo>  clone/pull into the right account folder, no enrollment

[agent] defaults to the repo you're standing in, so from inside a worktree:
  $CMD attach   /   $CMD restart   /   $CMD cmd "/compact"

roster: $CONF   (agent | worktree | gh_config_dir | claude_args)
hub opt-in list: ~/.mcp-hub/config.json — maintained by add/rm, never edit by hand
EOF
  ;;
esac
